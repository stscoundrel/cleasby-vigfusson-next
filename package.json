    "markari": "^1.0.7",
    "next": "16.3.4",
    "next-pwa": "^5.6.0",
    "old-norse-alphabet": "^1.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reset-css": "^5.0.2",
    "riimut": "^0.9.1",
    "sass": "^1.104.0",
    "scandinavian-dictionary-crosslinker": "^0.7.0",
    "sitemap": "^7.1.1",

            {
              "__html": "n. [Scot. <i>reif</i>], <i>a skin-eruption, scurf;</i> sló út um hörund hans ryfi ok úþvera með kláða miklum, Bs. i. 181.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rygir"

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjald-rim
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>the ‘shield-rim,’</i> i. e. the line of shields along the gunwale of a ship (skip skarat skjöldum), Orkn. 104 (in a verse), Fms, vi. (in a verse), xi. 140 (read. skjaldrimna).",
            }
          }
        />

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nytja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to milk;</i> nytja ærnar, Dropl. 14; var þat fé sumt etið, sumt nytjað, Sturl. iii. 208: reflex, <i>to yield milk,</i> fé nytjaðisk ílla, Ld. 154.",
            }

      <li>
        <a
          className="link"
          href="/word/gulpr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          gúlpr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a puff:</i> also of wind, norðan-gúlpr, <i>a northern blast.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/gvendr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          gvendr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "or <strong>Gvöndr,</strong> m. a pet proper name from Guð-mundr: <i>sanitary wells</i> are in Icel. called <strong>Gvendar-brunnr,</strong> m., from bishop Gudmund’s consecrating wells, Bs. i. 450, Ísl. Þjóðs. ii. 27. <strong>Gvendar-ber,</strong> n., botan. <i>equisetum arvense.</i> <strong>Gvendar-grös,</strong> n., botan. a kind of <i>weed.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/gyding-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          gyðing-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>Jewish.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/gydinga-land"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          gyðinga-land
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>Jewry, Palestine.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/gydinga-lydr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          gyðinga-lýðr
        </a>
        <p
          dangerouslySetInnerHTML={

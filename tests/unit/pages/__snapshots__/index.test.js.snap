          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          svik-máll
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>false-spoken,</i> Róm. 139.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/svik-rad"
          onClick={[Function]}

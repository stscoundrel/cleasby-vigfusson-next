          className="link"
          href="/word/djorfung"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          djörfung
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [djarfr], <i>boldness,</i> in a good sense, Fms. iv. 133, Pass. 40. 17: <i>impudence,</i> Fms. ii. 184, H. E. i. 503: cp. dirfð, dirfska.",
            }
          }
        />

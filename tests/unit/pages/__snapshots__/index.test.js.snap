          dangerouslySetInnerHTML={
            {
              "__html": "m. [Lat. <i>fundus;</i> A. S. <i>botm;</i> Engl. <i>bottom;</i> Hel. <i>bodm;</i> Germ. <i>boden;</i> Swed. <i>batten;</i> Dan. <i>bund</i>]:—<i>the bottom;</i> of a vessel, tunnu-botn, kistu-botn, etc., Nj. 133, Sturl. ii. 107, Hkr. ii. 245: <i>the bottom</i> of other things, e. g. of a haycock, Eb. 324; marar-botn, <i>the bottom of the sea.</i>",
            }
          }
        />
      </li>

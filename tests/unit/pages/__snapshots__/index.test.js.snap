        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. [Engl. <i>without</i>], <i>without, outside of,</i> in a nickname. Fas. iii.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-varnan"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-varnan
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>abstinence from,</i> Hom. 14.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-vik"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-vik
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a stirring;</i> lítið viðvik, <i>a small act.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-vindill"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-vindill
        </a>
        <p
          dangerouslySetInnerHTML={
            {

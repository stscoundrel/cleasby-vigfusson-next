            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vaendis-kona"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vændis-kona
        </a>

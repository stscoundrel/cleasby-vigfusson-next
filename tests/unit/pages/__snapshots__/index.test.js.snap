        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. [grúfa; Germ. <i>gräulich;</i> Dan. <i>gruelig;</i> Swed. <i>grulig;</i> Ivar Aasen <i>gruvaleg</i>]:—prop. <i>‘grovellingly,’</i> metaph. <i>shockingly,</i> Fb. ii. 26.",
            }

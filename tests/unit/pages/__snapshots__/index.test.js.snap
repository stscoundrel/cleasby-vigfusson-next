        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ar, m., dat. -mætti, <i>almightiness, omnipotence</i> (eccl.), of God, 671. 3; sinn alm́tt (acc.), Ísl. i. (Hom.) 386, Fms. i. 226, 655 vi. 2; vide almætti, n.",
            }
          }
        />
      </li>

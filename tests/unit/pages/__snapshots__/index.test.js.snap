        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a crutch,</i> Grett. 161, Mag. 66, Fb. i. 210, Fas. iii. 154; ganga á hækjum, <i>to go on crutches.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/haekka"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

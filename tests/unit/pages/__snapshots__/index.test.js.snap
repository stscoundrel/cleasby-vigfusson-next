        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skorpna"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skorpna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to be shrivelled,</i> Barl. 81; húð skorpnuð við eld, Nj. 208; þeir (the shoes) höfðu skorpnað í skininu, Háv. 25 new Ed.; skorpnar skór at fæti mér, Fms. vi. 45: metaph., það skorpnar at e-m, <i>to be hard pressed,</i> Fas. iii. 80.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

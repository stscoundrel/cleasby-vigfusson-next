        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>without greensward, rotten,</i> of soil, Hrafn. 26.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/svard-lykkja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          svarð-lykkja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. [svörðr], <i>a ring of a rope of walrus-hide,</i> Fms. viii. 216.",
            }

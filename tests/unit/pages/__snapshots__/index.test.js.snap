        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drengja-val"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drengja-val
        </a>
        <p
          dangerouslySetInnerHTML={
            {

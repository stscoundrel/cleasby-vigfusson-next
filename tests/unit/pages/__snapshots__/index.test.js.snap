          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sækinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>plucky;</i> eigi afl-mikill en þó ákatliga s., Sturl. i. 23.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/saekja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sækja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "i. e. <strong>sœkja,</strong> an irregular verb, pres. sæki (sœki); pret. sótti, qs. sókti (as þótti from þykkja; cp. Engl. <i>seek, sought);</i> subj. sækti (sœkti); imperat. sæk, sæktú: part. sóttr, sótt (qs. sóktr, cp. þótt from þykkja); subj. sætti, Þkv. 14: [sak, sök, sók-n, referring to a lost strong verb, saka, sök; Ulf. <i>sôkjan</i> = ζητειν, αἰτειν; A. S. <i>sêcan;</i> Engl. <i>seek;</i> O. H. G. <i>sohhjan;</i> Germ. <i>suchen;</i> Dan. <i>söge;</i> Swed. <i>söka.</i>]",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a saddle-tree;</i> í hann lagði tennr upp á söðultreyjuna, Fms. iv. 58; see trog-söðull.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sodulkollu-visur"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

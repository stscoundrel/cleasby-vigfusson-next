        <p
          dangerouslySetInnerHTML={
            {
              "__html": "tt, [grjót], <i>to stone;</i> g. e-n, <i>to stone one to death,</i> Landn. 236, Fms. v. 222, vi. 408, Stj. 256; g. at e-m, á e-n, <i>to pelt one with stones,</i> Fs. 36, 37, Eg. 581, Fms. i. 218, vii. 82, Hðm. 26, Stj. 402.",
            }
          }
        />

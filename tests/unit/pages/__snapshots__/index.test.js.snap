        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. id., Eg. 293, Finnb. 352.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skeitan"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skeitan
        </a>
        <p
          dangerouslySetInnerHTML={
            {

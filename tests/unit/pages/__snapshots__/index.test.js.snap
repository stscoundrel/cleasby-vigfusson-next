          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vessi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. [perh. akin to vatn or to varri; Dan. <i>vædske</i>], <i>a watery humour,</i> of the body, freq. in mod. usage. <strong>vessa-mikill</strong> and <strong>vessa-ríkr,</strong> adj. <i>humorous,</i> of the body.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vest-firdingar"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vest-firðingar
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. pl. <i>the men from</i> <strong>Vest-firðir,</strong> <i>the West-fiords</i> (in Icel.), Landn., Sturl.; vestfírðinga-fjórðungr, <i>the West Quarter,</i> Landn. 167.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vest-firdis"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          var-fleygr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>faltering in flight,</i> Stor.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/var-faerr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          var-færr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>cautious, wary,</i> Eg. 63. <strong>var-færni,</strong> f. <i>wariness.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/var-gefin"

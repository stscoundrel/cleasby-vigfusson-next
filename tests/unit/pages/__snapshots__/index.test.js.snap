          dangerouslySetInnerHTML={
            {
              "__html": "m. [<i>whoredom</i>], <i>adultery,</i> Stj. 301, K. Á. 132, 218, Barl. 134, Jb. 131, Hom. 86, 154. <strong>hórdóms-maðr,</strong> m. <i>an adulterer,</i> 625. 15.",
            }

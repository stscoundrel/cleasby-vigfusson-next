              "__html": "adj. (<strong>ein-þykkni,</strong> f.), <i>stubborn, self-willed,</i> Fb. i. 543.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ein-aeri"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ein-æri

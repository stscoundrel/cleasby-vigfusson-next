        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skrin-kista"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skrín-kista
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a shrine-chest,</i> Mar. xl.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skrin-klaedi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skrín-klæði
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. = skríndúkr, Vm. 46.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skrin-lagning"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skrín-lagning
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>enshrinement,</i> Magn 513.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skrin-leggja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

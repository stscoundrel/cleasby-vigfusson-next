          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          spenna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>spasm;</i> slikum spennum ok únáðum, Ísl. ii. 63: medic. <i>a fit of vomiting,</i> fá harðar spennur: <i>a grasping,</i> hrygg-spenna, q. v.",
            }
          }
        />
      </li>

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sjald-heyrdr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sjald-heyrðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>seldom heard,</i> Fær. 198.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sjald-kvaemr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sjald-kvæmr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>coming seldom,</i> Fbr. 31; ek em sjaldkvæm til kirkju, 170.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sjald-senn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sjald-sénn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>seldom seen,</i> Fms. iii. 182, Háv. 53, Barl. 17; sjaldsénir hvítir hrafnar, <i>white ravens are a rare sight,</i> a saying.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sjald-stundum"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sjald-stundum
        </a>
        <p
          dangerouslySetInnerHTML={

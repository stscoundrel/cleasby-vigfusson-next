        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. pl. <i>means enough for support.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/bjarg-festr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          bjarg-festr

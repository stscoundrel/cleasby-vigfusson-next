        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>ashes,</i> Stj. 124.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/svidu-kari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

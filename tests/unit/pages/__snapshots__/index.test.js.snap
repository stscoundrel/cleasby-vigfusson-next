          onTouchStart={[Function]}
        >
          læknari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a leech,</i> = læknir, Þórð. 70, Bs. i. 294.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/laekning"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lækning
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a cure,</i> as also <i>the art of healing,</i> Nj. 154, Sks. 117, Stj. 625, Hom. 133, Bs. i. 639–643:—<i>medicine,</i> góð lækning, Pr. 473; lækningar kaup, <i>a fee for a cure,</i> N. G. L. i. 67; lækningar lyf, <i>a medicine,</i> Stj. 272, see lyf; lækuingar bragð, <i>a cure,</i> Fms. viii. 442. <strong>lækninga-maðr,</strong> m. <i>a leech,</i> = læknir.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/laeknir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          læknir
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a leech, physician,</i> Sdm. 11, Nj. 89, MS. 623, 40, Fas. iii. 644, Hkr. ii. 376, Mar., Stj., Bs. i. 640 sqq., passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/laeknis-domr"
          onClick={[Function]}

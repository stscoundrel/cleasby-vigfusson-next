          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          van-ýfli
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. [the latter part of this compd has preserved the uncontracted form, answering to Goth. <i>ubils</i> = íllr, q. v.; cp. Engl. <i>evil</i> and contr. <i>ill</i>]:—<i>chronic ailments;</i> þessi vanýrli skaltú hafa á þínum hag, Sks. 360 B. <strong>vanyfla-sótt,</strong> f. <i>habitual illness</i> = vanasótt; kom v. hans at honum, Sks. 706 B (of king Saul’s insanity).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vana"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vana
        </a>
        <p
          dangerouslySetInnerHTML={

          onTouchStart={[Function]}
        >
          hæpið
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. adj. <i>doubtful:</i> in the phrase, það er hæpið, <i>‘tis very uncertain:</i> prop. <i>scanty,</i> a corrupt form for hneppt, qs. hept, as the word is indeed spelt in Grett. 169 new Ed., whence hæpið.",
            }
          }
        />
      </li>
      <li>

        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klerka-mal"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klerka-mál
        </a>
        <p
          dangerouslySetInnerHTML={
            {

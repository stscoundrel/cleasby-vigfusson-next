          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          heyri-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>openly,</i> 656 C. 2: <i>fittingly;</i> óheyriliga, <i>cruelly.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/heyri-ligr"

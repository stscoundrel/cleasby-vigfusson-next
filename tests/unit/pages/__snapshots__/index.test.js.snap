        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>lawfully-born, born in wedlock,</i> Fms. i. 193.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skil-dagi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skil-dagi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a condition, stipulation, terms,</i> Nj. 81, Ó. H. 47, 98, Gþl. 494, Fms. i. 22, 80, vi. 293, vii. 92, 147, Vm. 129, K. Á. 224, passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skil-fengin"
          onClick={[Function]}

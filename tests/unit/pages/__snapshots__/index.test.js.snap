      </li>
      <li>
        <a
          className="link"
          href="/word/eyrend-reki"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          eyrend-reki
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>örend-reki</strong> and <strong>erind-reki</strong>), a, m. [A. S. <i>ærend-raca</i>], <i>a messenger,</i> Post. 645. 27, Gþl. 12, 42, Greg. 44, Stj. 524, Barl. 52.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/eyrendi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          eyrendi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "or <strong>örendi, erendi,</strong> n. [A. S. <i>ærend</i> = <i>mandatum;</i> Engl. <i>errand;</i> Hel. <i>arundi;</i> O. H. G. <i>arunti;</i> Swed. <i>ärende;</i> Dan. <i>œrende;</i> akin to árr, a <i>messenger,</i> vide p. 45, and not, as some suggest, from ör-andi; the reference Edda l. c. is quite isolated; there is, however, some slight irregularity in the vowel]",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/eyri-lauss"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          eyri-lauss
        </a>
        <p
          dangerouslySetInnerHTML={
            {

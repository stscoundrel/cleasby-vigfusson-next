            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skrifari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skrifari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a painter,</i> Bs. i. 132, Eluc. 675. 26.",
            }

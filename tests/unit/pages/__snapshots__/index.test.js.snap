          href="/word/skja-vindauga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjá-vindauga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a</i> skjá <i>window,</i> Sturl. i. 168, Orkn. 250.",
            }

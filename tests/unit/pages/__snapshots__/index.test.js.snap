        >
          þoku-laust
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. adj. <i>without fog, clear,</i> Sturl. ii. 108.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thoku-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þoku-maðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

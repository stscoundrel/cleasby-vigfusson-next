        >
          klerka-sveit
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>the clerical body,</i> Sturl. i. 122: <i>a body of scholars,</i> Al. 8.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klerka-songr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klerka-söngr

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>crooked, winding;</i> krókótt á, <i>a winding river,</i> Pr. 476: <i>cunning,</i> Fb. i. 208: neut. krókótt, Band. 32 new Ed.",
            }

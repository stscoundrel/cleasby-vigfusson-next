            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ritari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ritari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a writer, transcriber,</i> Bs. i. 175, 191; Hallr hét ok var r. hans, <i>his secretary,</i> 700: <i>a scribe,</i> Al. 66, Greg. 52.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ritning"
          onClick={[Function]}

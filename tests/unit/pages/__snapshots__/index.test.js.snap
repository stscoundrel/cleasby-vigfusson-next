          onTouchStart={[Function]}
        >
          voga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to dare,</i> Bs. i. 868, Fas. i. 450, Grett. 157; see vága, p. 684.",
            }

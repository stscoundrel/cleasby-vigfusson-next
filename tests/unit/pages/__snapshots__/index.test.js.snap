          className="link"
          href="/word/thjod-gata"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þjóð-gata
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. = þjóðbraut, Ld. 66, Gþl. 82, 407, 408, Jb. 180.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

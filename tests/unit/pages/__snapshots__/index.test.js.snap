      <li>
        <a
          className="link"
          href="/word/mal-leysingi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mál-leysingi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a dumb, speechless person:</i> as also in the allit. phrase, menn ok málleysingar, <i>both men and dumb creatures.</i>",
            }
          }
        />
      </li>
      <li>

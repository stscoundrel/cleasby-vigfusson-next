          className="link"
          href="/word/tyjandi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          týjandi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a helper;</i> töyendr, <i>helpers,</i> Hom. 149.",
            }
          }
        />
      </li>
      <li>

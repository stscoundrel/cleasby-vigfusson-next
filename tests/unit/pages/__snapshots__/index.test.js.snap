        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skyn-lauss"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skyn-lauss
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>senseless, irrational;</i> s. skepna, skynlaust kykvendi, <i>an irrational being, a brute, animal,</i> Sks. 46, Barl. 165, MS. 623. 18; skynlaus rödd, <i>an irrational sound,</i> Skálda 170; s. maðr, Sks. 246; s. snápr, Barl. 165.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drengs-bot"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drengs-bót
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>what makes a man the better</i> d., Fms. ii. 276, vi. 107, Karl. 120.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drengs-bragd"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drengs-bragð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>the deed of a</i> d., <i>brave deed</i>, Sturl. ii. 84.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drep"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drep
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [A. S. <i>drepe;</i> Germ. <i>treff</i>], <i>a smart, blow;</i> the legal bearing of this word is defined Grág. Vsl. ch. 10–13; wound and ‘drep’ are distinguished—þat ero sár er þar blæðir sem á kom, en drep ef annars-staðar blæðir, ch. 51, cp. N. G. L. i. og, 164, Eb. ch. 23: <i>trail</i>, vide dögg.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drep-hrid"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drep-hríð

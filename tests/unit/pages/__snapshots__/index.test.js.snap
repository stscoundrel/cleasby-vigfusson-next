        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a bed-fellow,</i> Fms. iii. 199.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rekkju-golf"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rekkju-gólf
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a bed-closet,</i> Þorst. Stang. 55.",
            }
          }
        />
      </li>
      <li>

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> u, f. [dúnn]. <i>a down-bed, feather-bed, a pillow</i> or <i>bolster,</i> Fms. iii. 125, vi. 279, ix. 26, x. 186, Dipl. iii. 4, Bs. ii. 167, Lex. Poët.",
            }

          onTouchStart={[Function]}
        >
          ungr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ung, ungt, adj., compar. yngri, superl. yngstr; for the form <strong>jungr</strong> see p. 327, col. 1: [Goth. <i>juggs,</i> compar. <i>juhiza;</i> A. S. <i>geong;</i> Engl. <i>young;</i> O. H. G. and Germ. <i>jung;</i> Dutch <i>jong;</i> but Dan.-Swed. <i>ung;</i> cp. Lat. <i>juvenis.</i>]",
            }
          }
        />

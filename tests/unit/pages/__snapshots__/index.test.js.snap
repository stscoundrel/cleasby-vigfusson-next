        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. and <strong>bjargræðisvegir,</strong> m. pl. <i>means for support.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/bjarg-skora"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          bjarg-skora
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a scaur</i> or <i>scar on a hill,</i> Anal. 177, Ann. 1403, Hkr. iii. 323.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/bjarg-snos"

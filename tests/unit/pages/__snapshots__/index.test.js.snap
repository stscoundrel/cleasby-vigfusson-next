        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>the pack on a horse,</i> Nj. 56.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klyfja-burdr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klyfja-burðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>carrying packs on horseback,</i> Fbr. 65, Nj. 56, v. l.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klyfja-hestr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klyfja-hestr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. and <strong>klyfja-hross,</strong> n. <i>a pack-horse,</i> K. Þ. K. 80, Nj. 264, Landn. 152, Grág. ii. 279, Fbr. 41, 42 new Ed., Eb. 296, Þorst. Síðu H. 13.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klykkja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klykkja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "t, [klukka], <i>to ring;</i> þar er klykt, 671. 16; klykkir til fórnar upphalds, Mar., N. G. L. ii. 242, D. N. ii. 77; but in Icel. hringja is the common word.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

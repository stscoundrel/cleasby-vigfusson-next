      </li>
      <li>
        <a
          className="link"
          href="/word/ham-fagr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ham-fagr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>fair of hue, bright,</i> Ad. 7.",
            }

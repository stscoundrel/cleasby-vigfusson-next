          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skorri
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. a bird, <i>the pie</i> (?), = skærr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skort"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skort
        </a>
        <p
          dangerouslySetInnerHTML={
            {

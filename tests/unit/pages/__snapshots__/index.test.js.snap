        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n., botan. <i>goat-weed</i> = <i>aegopodium,</i> Hjalt.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skolla-leikr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

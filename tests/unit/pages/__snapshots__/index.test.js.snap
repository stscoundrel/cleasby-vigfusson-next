        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>cloakless,</i> Fms. vii. 143, Sks. 289, Ld. 168.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

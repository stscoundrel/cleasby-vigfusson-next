        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, = skeypa; skopast að e-u, <i>to scoff, mock.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skopan"

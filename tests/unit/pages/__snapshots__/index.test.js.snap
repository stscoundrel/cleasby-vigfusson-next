          onTouchStart={[Function]}
        >
          sára-far
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n.<i>the state of the wounds;</i> hann varð heill sárafars þessa, Bs. i. 419; hrakningar ok s., Nj. 137; hvert s. hann veitti honum, Bjarn. 65; þá er hann fékk vansa í sárafari, Sturl. i. 103; ok er leitað var til sárafars Þorbjarnar, Orkn. 458.",
            }
          }
        />
      </li>
      <li>

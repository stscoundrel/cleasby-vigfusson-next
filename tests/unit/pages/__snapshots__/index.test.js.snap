          út-nyrðingr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a north-west wind,</i> Ld. 42, Lv. 99, Sks. 40; út-nyrðingi steinóðum, 656 C. 21.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ut-ras"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          út-rás
        </a>
        <p
          dangerouslySetInnerHTML={
            {

      </li>
      <li>
        <a
          className="link"
          href="/word/horpu-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hörpu-maðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a harp-man, harper,</i> Sams. S. 9.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/horpu-slagi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hörpu-slagi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "and <strong>hörpu-slagari,</strong> a, m. <i>a harper,</i> Bs. i. 866, 909.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/horpu-slagr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hörpu-slagr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>hörpu-sláttr,</strong> m. <i>striking the harp,</i> Bs. i. 202, Str. 83.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/horpu-stokkr"
          onClick={[Function]}

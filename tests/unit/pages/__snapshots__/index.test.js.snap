        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. = framferð, Fms. ii. 37: <i>conduct,</i> 655 xxxii. 2, Stj. 8, 142, Bs. i. 840, Fms. vi. 133: freq. in mod. use, N. T., Vídal.",
            }
          }
        />

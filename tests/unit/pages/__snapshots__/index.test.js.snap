        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>the evening red of the sky,</i> opp. to morgun-roði.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kveld-seta"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kveld-seta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a sitting up late,</i> Fms. vii. 126.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kveld-stjarna"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kveld-stjarna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>the evening star.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kveld-svaefr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kveld-svæfr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>fond of sleep in the evening,</i> opp. to morgun-svæfr, Eg. 3, Fms. vii. 126.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

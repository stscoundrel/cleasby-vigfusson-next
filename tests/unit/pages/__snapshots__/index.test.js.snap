        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. = túnannir, as also the season, the 12th and following weeks of the summer.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tuta"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          túta
        </a>
        <p
          dangerouslySetInnerHTML={

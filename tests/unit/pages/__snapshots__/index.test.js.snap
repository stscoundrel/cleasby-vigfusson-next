            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/glossi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          glossi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. [<i>glousse</i> = <i>a spark,</i> De Professer], <i>a blaze.</i>",
            }
          }

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "t, <i>to share by lots,</i> Stj. 375.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-skipti"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-skipti
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a sharing,</i> Eg. 280, Fms. i. 183: <i>a share, lot</i>, of inheritance, Fs. 18, Ld. 222: of booty, Eg. 4, 57, Fms. vi. 86, vii. 278, Bs. i. 37, Barl. 188.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

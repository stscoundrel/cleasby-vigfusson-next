          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skyn-fullr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>reasonable,</i> Mar.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skyn-godr"
          onClick={[Function]}
          onMouseEnter={[Function]}

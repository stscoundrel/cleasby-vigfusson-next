        <a
          className="link"
          href="/word/therri-leysa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þerri-leysa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>want of dryness, a wet season,</i> Ann. 1312; þerrileysi-sumar, <i>a wet summer,</i> id.",
            }

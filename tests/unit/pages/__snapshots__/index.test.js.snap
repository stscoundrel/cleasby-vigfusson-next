            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kaekr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kækr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a</i> (<i>strange</i>) <i>habit, mannerism;</i> það er ekki nema kækr, göra sér upp kæki, <i>to feign.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kaela"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kæla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(i. e. <strong>kœla</strong>), d, [causal from kala, kól; Germ. <i>kühlen</i>]:—<i>to cool,</i> Edda 7, Þiðr. 95, Barl. 132; lét jarl bera vatn í ok kæla grjótið, Orkn. 352; hann hafði kælt á sér marga hluti, Stj. 156; at hann kæli mína tungu, id.; at hann drepi hinu minnsta síns fingrs í vatn ok kæli tungu mína, Luke xvi. 24: part. kældr = kaldr, vóru þar þá mjök kæld híbýli, Sturl. ii. 109.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kaen-leikr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kæn-leikr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>craft, sagacity,</i> Hkr. i. 254, Sturl. iii. 315, Fms. viii. 292.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kaen-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kæn-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>cleverly, warily,</i> Fms. viii. 289, xi. 326; fara k., <i>to go warily,</i> Finnb. 352.",
            }

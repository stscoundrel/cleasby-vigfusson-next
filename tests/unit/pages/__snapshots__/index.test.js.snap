      <li>
        <a
          className="link"
          href="/word/tvil"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tvíl
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [Ulf. <i>tweifls;</i> Germ. <i>zweifel;</i> Dan. <i>tvil</i>], <i>doubt.</i> <strong>tvíl-laust,</strong> n. adj. <i>without doubt, forsooth.</i> <strong>tvíla,</strong> að, <i>to doubt,</i> (mod.); as also <strong>tvílugr,</strong> adj., in ó-tvílugr, <i>quite safe;</i> hann er ó-tvílugr, það er ó-tvílugt; but none of these words are found in old writers.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tvimaelis-lauss"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tvímælis-lauss
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>undisputed,</i> Sturl. iii. 261.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tvimaelis-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tvímælis-maðr
        </a>
        <p
          dangerouslySetInnerHTML={

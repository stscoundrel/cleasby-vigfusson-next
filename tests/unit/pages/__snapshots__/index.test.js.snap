        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nupr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          núpr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. = gnúpr, q. v.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nybba"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nybba
        </a>
        <p
          dangerouslySetInnerHTML={

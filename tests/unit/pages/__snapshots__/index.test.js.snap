          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>fit for sail;</i> váðhæft-veðr, <i>a favourable wind;</i> hvessti svá at varla var váðhæft á konungs skipi, Fms. ix. 387.",
            }
          }
        />
      </li>
      <li>

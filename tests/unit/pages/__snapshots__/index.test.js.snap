          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skamtr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [cp. Engl. <i>scant</i>], <i>a share, portion;</i> setja e-m skamt, Róm. 132; skornum skamti, <i>in short measure, scantily,</i> Nikdr. 68; þá hefir hann skamt logit á hendr sér, N. G. L. i. 73.",
            }
          }
        />
      </li>
      <li>

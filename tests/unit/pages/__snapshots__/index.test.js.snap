            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vesti"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vesti
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [from the Engl. through Dan.], <i>a waistcoat</i> (mod.)",

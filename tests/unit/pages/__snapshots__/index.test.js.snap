        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>meet, fit;</i> bjóða þeim öllum heim til vistar, þat væri þermsligt, Ísl. ii. 387.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/therna"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

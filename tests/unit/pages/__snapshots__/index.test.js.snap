          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mál-latr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>slovenly in speaking;</i> hón var ekki til mállöt (<i>she was a gossip</i>) ok sagði þeim til mart, Bjarn. 60, Mork. 38.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

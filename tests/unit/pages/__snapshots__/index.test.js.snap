        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>subject, yielding</i> lýðskylda <i>to one,</i> Eg. 14; vóru þá jarlar honum lýðskyldir, Ó. H. 91, Fms. i. 14.",
            }
          }
        />
      </li>
      <li>

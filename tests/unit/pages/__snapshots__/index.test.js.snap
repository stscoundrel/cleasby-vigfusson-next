        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thung-faerask"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þung-færask
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ð, <i>to become heavy, infirm,</i> Fas. i. 388.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thung-faerr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þung-færr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>heavy to move,</i> Fms. ix. 289: <i>infirm,</i> Eg. 754, Fms. vii. 5, Fb. i. 47.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thung-gengt"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þung-gengt
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. part., e-m verðr þunggengt, Fms. ix. 511.",
            }
          }

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a bag for the pieces,</i> Gullþ. 20.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tafl-speki"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tafl-speki
        </a>
        <p
          dangerouslySetInnerHTML={

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj., (sjón-hannarr, Ó. H. 16; sjón-hannr, Fms. iv. 38, l. c.; sjónandr, Hkr. ii. l. c.):—<i>having an expert, artistic eye;</i> hann var s. um smíðir allar, Ó. H.; see hannr.",
            }

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dyrdar-stadr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dýrðar-staðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a glorious place,</i> Ver. 3.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dyrdar-songr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dýrðar-söngr
        </a>
        <p
          dangerouslySetInnerHTML={

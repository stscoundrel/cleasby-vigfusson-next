        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. = þarfleysa; þarfleysi ætla ok þat vera, Ísl. ii. 207.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tharf-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þarf-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>usefully.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tharf-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þarf-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>useful,</i> Gþl. 161, H. E. i. 504, Jb. 187 B, passim.",
            }

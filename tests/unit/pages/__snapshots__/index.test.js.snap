              "__html": "u, f. <i>an obscene song.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klam-yrdi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klám-yrði
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>foul language,</i> Fb. iii. 415, 427.",
            }
          }
        />

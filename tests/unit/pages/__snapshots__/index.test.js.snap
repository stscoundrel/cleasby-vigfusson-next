      </li>
      <li>
        <a
          className="link"
          href="/word/skjala"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjala
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to prate, swagger,</i> Fas. iii 273, 284, Grett. 89 new Ed.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skjala-safn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjala-safn

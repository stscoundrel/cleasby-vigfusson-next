          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skjald-maer"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjald-mær
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a ‘shield-maid,’ amazon,</i> Akv. 17, Al. 121, Fas. i. 140, 177, Odd. 22, 26.",
            }
          }
        />
      </li>
      <li>

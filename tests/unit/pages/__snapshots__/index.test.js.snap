        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n, f. [ólga], <i>a swelling, rolling,</i> as a naut. term; það er ylgja í sjónum, <i>a heavy rolling;</i> lítil bylgja þá lág er ylgja, Stef. Ól.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to hit in the head,</i> metaph. <i>to harm;</i> þykkir nú sem þeim muni ekki kolla, Sturl. iii. 237.",
            }
          }
        />

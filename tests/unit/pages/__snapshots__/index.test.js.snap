            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aldr-slit"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          aldr-slit
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. <i>death</i>, in the phrase, til aldrslita, <i>ad urnam,</i> Sturl. iii. 253.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aldr-stamr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

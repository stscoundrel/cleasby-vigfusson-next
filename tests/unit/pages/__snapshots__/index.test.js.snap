          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          brauttu
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. a shouting, = braut-þú, <i>away thou! begone!</i> Eirsp. 247.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

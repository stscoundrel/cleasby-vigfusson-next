          className="link"
          href="/word/opin-berliga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          opin-berliga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>openly, in public,</i> Nj. 165, Fms. i. 142, ii. 184, ix. 452, K. Á. 108, Dipl. i. 7, Sks. 577.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/opin-berligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          opin-berligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>manifest,</i> Stj. 250: <i>public,</i> o. skript, Fas. ii. 174.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/opin-berr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          opin-berr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. [Germ. <i>offenbar</i>], <i>manifest,</i> Sks. 714; göra opinbert, Fms. ii. 104: <i>open,</i> o. víðátta, Sks. 504; <i>notorious,</i> o. mál, K. Á. 152; o. ránsmaðr, 62; o. okrkarl, 62, 208.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/opin-eygr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          opin-eygr
        </a>
        <p
          dangerouslySetInnerHTML={

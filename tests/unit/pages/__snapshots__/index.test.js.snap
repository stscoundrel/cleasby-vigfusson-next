        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a rumour come abroad;</i> var þat á m. komit, Hom. 115.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/mal-reifr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mál-reifr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

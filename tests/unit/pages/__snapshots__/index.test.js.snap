        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. [smeygja, smjúga, cp. Germ. <i>smeicheln</i>], prop. <i>‘insinuating,’ cringing, sleek;</i> Snorri bauð þá sínum herra smeykinn heim í holtið Reykja, Gd. 22.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/smeykligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

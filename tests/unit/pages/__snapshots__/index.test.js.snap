          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          inning
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [inna], <i>a discharge;</i> inning ok efning máldaga, Grág. i. 316.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/innir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          innir
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a performer,</i> Lex. Poët.",

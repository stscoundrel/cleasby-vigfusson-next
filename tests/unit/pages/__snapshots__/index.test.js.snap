        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>meddlesome,</i> Fs. 123; ó-hlutdeilinn, <i>passive.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-deilni"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-deilni
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>meddlesomeness,</i> Rd. 255, Karl. 123.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-drjugr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-drjúgr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>lucky, getting the better share,</i> Lv. 24.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-fall"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-fall
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n., chiefly in pl., <i>a casting of lots;</i> leggja til hlutfalla, Fs. 67, Fms. v. 147; fara at hlutföllum, <i>to go by lots,</i> Ver. 4; bjóða til hlutfalla, a law term, <i>to bid one proceed to cast lots,</i> Grág. i. 37, Nj. 232; skipta til hlutfalls, <i>to divide into lots,</i> Gþl. 341.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-felling"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-felling
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>proportion,</i> Alg. 372.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-gengr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-gengr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>capable, up to the mark,</i> Fb. ii. 329.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-girni"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-girni
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>meddlesomeness,</i> Glúm. 353.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-gjarn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-gjarn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>meddlesome,</i> Ld. 248.",
            }

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þung-býlt
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. adj.; e-m verðr þungbýlt, <i>to be hardly dealt with in one’s neighbourhood,</i> Ld. 26.",
            }

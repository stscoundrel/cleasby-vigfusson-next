          onTouchStart={[Function]}
        >
          tún-riða
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a ‘hedge-rider,’ a witch, ghost;</i> witches and ghosts were thought to ride on hedges and the tops of houses during the night, see Glam in the Grettla; cp. Swed. <i>‘blå-kulla;’</i> the word is a απ. λεγ., Hm. 156.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tun-svid"
          onClick={[Function]}

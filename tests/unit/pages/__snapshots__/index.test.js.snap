          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rótar-tré
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a root-tree, a tree with the root,</i> Grett. 151.",
            }

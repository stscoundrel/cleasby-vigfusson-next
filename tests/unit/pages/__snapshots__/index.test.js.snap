      <li>
        <a
          className="link"
          href="/word/klerka-lydr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klerka-lýðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>id.,</i> 623. 15.",
            }

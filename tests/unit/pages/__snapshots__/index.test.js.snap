            {
              "__html": "n. <i>a libel,</i> Eb. (in a verse).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klam-visa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klám-vísa
        </a>
        <p
          dangerouslySetInnerHTML={

        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-likr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-líkr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>‘such like,’ similar;</i> grjóns eðr annars viðlíks ávaxtar, Gþl. 524, freq. in mod. usage.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-laegt"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-lægt
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. adj. <i>on the verge of;</i> var þá viðlægt at þeir mundi berjask, Fms. ii. 235; viðrlægt, Stj. 394.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-logur"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-lögur
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. pl. = viðrlög, <i>fined</i>; mannhelgr mikil ok miklar viðlögur við manns aftak, Fms. x. 391, Jb. 56 (sing.): mod. phrase, í viðlögum, <i>in an emergency, stress.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-mot"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drengr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drengr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m., pl. ir, gen. drengs, pl. drengir, on Runic stones drengjar; this is a most curious word, and exclusively Scandinavian; it occurs in the A. S. poem Byrnoth, but is there undoubtedly borrowed from the Danes, as this poem is not very old.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drengs-adal"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drengs-aðal
        </a>
        <p
          dangerouslySetInnerHTML={
            {

        <a
          className="link"
          href="/word/ut-legjask"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          út-legjask
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "lagðisk, [útlagr 1], <i>to be fined;</i> útleggsk hann um fram, Grág. i. 248; ok verðr hann útlagr þrem mörkum ok gjaldi fúlgu, … en eigi útleggsk hann, ef hann getr þann kvið, at …, 259.",
            }
          }
        />
      </li>

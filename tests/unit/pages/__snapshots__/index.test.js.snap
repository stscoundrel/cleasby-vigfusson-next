          className="link"
          href="/word/lokkan"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lokkan
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>an allurement,</i> Stj. 38, H. E. i. 490, Barl. 129.",
            }
          }
        />
      </li>
      <li>

          onTouchStart={[Function]}
        >
          hrufla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to scratch,</i> Karl. 202, Mar.: reflex. <i>to be scratched,</i> of the skin, þar hefði hann hruflast og beinbrotnað, … eins hrufluðust hans áræðnu hendr á klettunum, Od. v. 426, 435.",
            }
          }

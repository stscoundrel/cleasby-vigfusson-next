          className="link"
          href="/word/orva-maelir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          örva-mælir
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m., Fms. iii. 223.",
            }
          }
        />
      </li>
      <li>

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/leikara-songr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          leikara-söngr
        </a>
        <p
          dangerouslySetInnerHTML={

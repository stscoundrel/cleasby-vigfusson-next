          onTouchStart={[Function]}
        >
          missa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a loss,</i> Al. 56, Eg. 40, Mar.; betra er oss skarð ok missa í flota Ólafs konungs, Hkr. i. 334; aftaka ok m., Edda 37; sorg ok m., Merl. 1. 39.",
            }
          }
        />
      </li>
      <li>

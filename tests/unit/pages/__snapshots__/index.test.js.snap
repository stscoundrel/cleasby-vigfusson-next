          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fagna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, [Ulf. <i>faginon</i> = χαίρειν; A. S. <i>fægnian</i>; Hel. <i>faganon</i>; cp. Engl. <i>fain</i>, Icel. feginn]:—<i>to be fain, to rejoice</i>, Greg. 20, 40, Sks. 631; fagnið þer og verið glaðir. Matth. v. 12, John xvi. 20; fagnið með fagnendum, Rom. xii. 15: with dat., fagna e-u, <i>to rejoice in a thing</i>; allir munu því fagna, 623. 43, Nj. 25, Ld. 62.",

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fyrning
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>decay,</i> Grág. ii. 267: pl. fyrningar, <i>old stores</i> left from last year, hey-f., matar-f., etc., (mod.)",
            }
          }
        />
      </li>

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/deildar-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          deildar-maðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "v. dældarmaðr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/deili"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          deili
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. <i>marks,</i> whereby to discern one thing (person) from another; sá þó öll d. á honum, <i>all his features were visible,</i> Fas. i. 298; the metaph. phrase, kunna, vita, deili á e-u (e-m), <i>to know the marks of a thing (man),</i> i. e. <i>to know it so as to discern it from another thing;</i> vita öll d. á, <i>to know exactly;</i> vita eingi d. á, <i>to know nothing about,</i> Eg. 185, Fas. ii. 113, Fms. v. 316.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/deili-ker"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          deili-ker
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a cup,</i> Js. 78, cp. N. G. L. i. 211.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/deili-steinn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          deili-steinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a ‘mark-stone,’ land-mark,</i> D. N.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/deiling"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

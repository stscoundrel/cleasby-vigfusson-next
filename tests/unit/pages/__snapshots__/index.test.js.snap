      <li>
        <a
          className="link"
          href="/word/rota-2"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          róta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>sleet and storm;</i> var á róta mikil, ok stökk saurr af jörðu, Bs. i. 334; hregg ok róta, 339; hagl eðr drífa eðr róta, Edda 87; róta veðr, Hkr. iii. 315. <strong>rótu-sumar,</strong> n. <i>a rainy, stormy summer,</i> Ann. 1226.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rota-3"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          róta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, [Engl. <i>to rout;</i> Dan. <i>rode;</i> Lat. <i>rōdere,</i> but not borrowed from the Lat. word]:—<i>to rout up, turn up,</i> of swine; er unnsvin róta upp, Eyvind (in a verse); nema túnsvin sé þat er eigi má róta, Grág. ii. 232.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rota-klumba"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          róta-klumba
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "or <strong>róta-kylfa,</strong> u, f. <i>a club.</i> AI. 77, Fms. i. 177, ii. 163.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rotar-drattr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rótar-dráttr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>root-extraction,</i> 544. 45.",
            }
          }
        />

          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>popularity;</i> fá tiðleik ok metnuð, Ver. 26; vera í tíðleikum við konu, <i>to go a courting,</i> Bs. i. 652.",
            }
          }
        />

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>vehement,</i> Barl. 56; æsiligr harmr. Mar.: æsiligt mein, Bs. i. 116; sullr æ., 345; æsilig sótt, 308, 318; æsiligr vatna-gangr, Stj.; æsilig gerð, <i>fermentation,</i> Bs. i. 340.",
            }
          }
        />
      </li>

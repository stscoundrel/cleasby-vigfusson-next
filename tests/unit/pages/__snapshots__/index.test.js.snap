          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          múgr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [akin to Engl. <i>mow</i>], <i>a swathe,</i> but only in the weak form múgi; hann hafði slegit þúfur allar ok fært þær saman í múga, … ok er kallaðr ákvæðis-teigr milli hverra múga, Fb. i. 522, freq. in mod. usage, <strong>múga-sláttr,</strong> m. <i>mowing into swathes,</i> Fb. i. 522.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

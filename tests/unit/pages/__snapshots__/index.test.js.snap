              "__html": "a, m. = hreppstjóri, Grág. i. 262.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hrepps-umagi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hrepps-úmagi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a pauper.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hreppsoknar-menn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hreppsóknar-menn
        </a>

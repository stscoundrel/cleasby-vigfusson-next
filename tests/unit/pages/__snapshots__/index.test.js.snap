              "__html": "n. <i>a snappish, testy person;</i> k. í skapi, Finnb. 280.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kofri"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

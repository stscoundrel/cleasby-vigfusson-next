          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          túlkari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>an interpreter:</i> a nickname, dóttir Kára þess er t. var kallaðr, Landn. 158, v. l., of a person of the 11th or 12th century.",
            }
          }
        />
      </li>

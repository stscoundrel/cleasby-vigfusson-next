        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a thunder-stone,</i> in popular superstition.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thrumu-vedr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þrumu-veðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

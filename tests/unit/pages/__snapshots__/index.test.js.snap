        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [cp. Germ. <i>wesen</i>], <i>a being, essence,</i> MS. 677. 3, 10, Hom. (St.); hverjar greinir hans vesningar eru, id.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skyn-leikr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>intellect, insight,</i> Mar.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skyn-leysi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

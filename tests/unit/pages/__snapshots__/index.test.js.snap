          onTouchStart={[Function]}
        >
          tún-völlr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a strip of the in-field,</i> Kormak, Grág. ii. 257, Jb. 423. Sturl. i. 83, Eb. 250; hann lét færa farminn heim á túnvöll sinn ok görði þeim tjald, Fb. i. 422.",
            }
          }
        />
      </li>
      <li>

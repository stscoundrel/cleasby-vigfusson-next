          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          senni-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>verily, forsooth,</i> Magn. 488, Str. 29, 126, Stj. 49, Grett. 154 A, Mar.: mod. usage distinguishes between senniliga = <i>probably,</i> and sannliga = <i>verily.</i>",
            }
          }
        />
      </li>

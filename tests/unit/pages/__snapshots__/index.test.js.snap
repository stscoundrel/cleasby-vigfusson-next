          dangerouslySetInnerHTML={
            {
              "__html": "f., <strong>spörð,</strong> Sighvat, [spara], <i>sparing,</i> Barl. 120; erat af spörð, <i>not sparingly,</i> Sighvat.",
            }
          }
        />
      </li>
      <li>

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>division, dealing.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/deilir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          deilir
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a dealer.</i> Lex. Poët.: arithm. <i>divisor.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/deill"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          deill
        </a>
        <p
          dangerouslySetInnerHTML={

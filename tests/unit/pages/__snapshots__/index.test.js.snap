          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tví-ærr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>of two years, two years old,</i> D. N.; tvíær landskyld, id.",

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. [A. S. <i>snearlice</i>], <i>quickly,</i> Boll. 360: temp., níta s., MS. 4. 5, passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snar-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

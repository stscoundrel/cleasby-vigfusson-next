        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>necessary,</i> Eg. 182, Ísl. ii. 151, Fms. i. 262, vi. 8, passim:—<i>compulsory,</i> K. Á. 74:—<i>hard, severe,</i> Sks. 710.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/naud-virktar-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nauð-virktar-maðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. = nauðleytarnaðr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nauda"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nauða
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to rustle,</i> Sd. 160: = gnauða, q. v.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nauda-handsal"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nauða-handsal
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>an enforced hansel,</i> not valid in law, Grág. i. 493.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nauda-kostr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nauða-kostr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a dire choice,</i> Stj. 368.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nauda-laust"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nauða-laust
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. adj., or at nauðalausu, <i>without necessity,</i> N. G. L. i. 349.",
            }

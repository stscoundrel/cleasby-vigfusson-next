          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hneisa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> u, f., but better <strong>neisa</strong> (q. v.), see Hm. [Swed. <i>nesa</i>]:—<i>shame, disgrace,</i> Fms. viii. 20, x. 223, 346, 394, xi. 86, Ó. H. 107.",
            }
          }
        />
      </li>
      <li>

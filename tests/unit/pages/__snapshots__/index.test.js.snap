          href="/word/myrk-fara"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          myrk-fara
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f., poët. <i>the ‘mirk-farer,’</i> i. e. <i>the night,</i> Edda (Gl.)",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/myrk-faelinn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

              "__html": "n. <i>fissura ani.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rass-gorn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rass-görn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>the great gut,</i> Nj. 185.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rass-hverfingr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rass-hverfingr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. of a horse of which <i>the anus protrudes,</i> N. G. L. i. 75.",

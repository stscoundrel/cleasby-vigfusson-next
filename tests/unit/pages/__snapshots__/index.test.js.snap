          dangerouslySetInnerHTML={
            {
              "__html": "f. [Ulf. <i>hleiþra</i> or <i>hleþra</i> = σκηνή], prop. <i>a tent;</i> it exists only as the local name of the old Danish capital, Fas., Fms., and in <strong>Hleiðrar-garðr,</strong> m., Landn.",
            }

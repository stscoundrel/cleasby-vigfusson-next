          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hreppa-lög
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. <i>the laws and rules of a Rape,</i> Grág. i. 443.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hreppa-madr"
          onClick={[Function]}

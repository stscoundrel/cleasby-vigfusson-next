          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kolla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f., prop. <i>a deer without horns, a humble deer, a hind;</i> féll hann þar á grasvöllinn hjá kollunni, Str. 4, 7; hirtir allir ok kollur, Karl. 476, (hjart-kolla, q. v.)",
            }
          }
        />
      </li>
      <li>

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          var-goldinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>underpaid,</i> Ó. H. 149: of <i>insufficient revenge,</i> Sturl. ii. 224.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

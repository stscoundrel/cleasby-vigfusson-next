          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kvækla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, [kvak], <i>to chirp,</i> Fas. iii. 372.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kvaelni"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kvælni
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. = kvelni, Hom. 122 new Ed.",
            }
          }
        />
      </li>
      <li>

          onTouchStart={[Function]}
        >
          dróttin-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>lord-like, of the Lord,</i> Bs. i. 171, Stj.; Drottinleg bæn, <i>the Lord’s Prayer,</i> Mar., Hom. 26; d. dæmi, 656 A. 24.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drottin-svik"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dróttin-svik
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. <i>treason towards a lord</i> or <i>master,</i> Hkr. ii. 132, Sks. 571, Hom. 23 (Judas).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drottin-svikari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dróttin-svikari
        </a>
        <p
          dangerouslySetInnerHTML={

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          krákr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. a kind of <i>crow</i> or <i>raven,</i> Edda (Gl.); ber þú sjálfr krák þinn, <i>carry thou thy crow thyself!</i> Þorst. Síðu H. 2; líka-krákr, a kind <i>of pole</i> for digging graves.",
            }

          onTouchStart={[Function]}
        >
          efi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m., in old writers almost always <strong>ifi</strong>:—<i>doubt,</i> Greg. 37, Fms. iii. 8, x. 392, Hkr. i. 223; vera ifa, <i>to be in doubt,</i> Mar. 17; enn er eptir ifi í hug mínum, 623. 26; án ifa (efa), <i>without doubt,</i> Fms. x. 336, Skálda 210: <i>suspicion,</i> Fms. x. 260.",
            }
          }
        />
      </li>
      <li>

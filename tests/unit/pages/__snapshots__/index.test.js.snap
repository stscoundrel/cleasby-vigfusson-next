        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>sharply;</i> sækja at s., Finnb. 352; skjóta s., Am. 42: <i>keenly, acutely,</i> svara s., freq. in mod. usage.",
            }

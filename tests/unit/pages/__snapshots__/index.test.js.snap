        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. = skíðsleði, Fb. ii. 169.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skid-laegr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skíð-lægr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>level, horizontal;</i> þar skíðlægt yfir, Bs. ii. 81.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skid-sledi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

      </li>
      <li>
        <a
          className="link"
          href="/word/aldradr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          aldraðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>elderly,</i> Fms. i. 70, 655 xiv. B. I; öldruð kona, Greg. 27.",
            }

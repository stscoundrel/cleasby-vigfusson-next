      <li>
        <a
          className="link"
          href="/word/skjald-kaenn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjald-kænn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. = skjaldfimr, Lex. Poët.",

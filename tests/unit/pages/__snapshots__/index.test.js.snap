          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vin-raun
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a trial of friends</i> or <i>friendship;</i> hörð mun v. verða, viz. to choose between two friends, Orkn. (in a verse): <i>a proof of friendship,</i> hann tók allvel við Þorkatli ok kvað slíkt v. mikla, Dropl. 23.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

          dangerouslySetInnerHTML={
            {
              "__html": "f. and <strong>Leifr,</strong> m., pr. names, Landn.; and in compds, of women, Ingi-leif, Ás-leif, etc.; of men, Þor-leifr, Hjör-leifr, etc., id.",
            }
          }
        />
      </li>

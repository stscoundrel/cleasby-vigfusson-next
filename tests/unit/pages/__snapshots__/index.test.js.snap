          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rekkja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f., gen. pl. rekkna, Edda 29, Róm. 195 (spelt rokna); also spelt <strong>reykja,</strong> Fms. v. 38, 183, 334, 339; or even <strong>rjukja</strong> in Art.:—<i>a bed,</i> Nj. 14, Eg. 24, 125, 765, Edda 9, Fær. 197, Fs. 5, 143, Fb. i. 43, Fms. iv. 318, passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rekkjod"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rekkjóð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. (qs. rekkjuváð), <i>a bed-sheet.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rekkju-bunadr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

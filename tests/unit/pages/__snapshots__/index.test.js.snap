        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>procedure, course of procedure,</i> Bs. i. 840, Fms. i. 126, vii. 296: <i>conduct,</i> Stj. 141.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/fram-ferdi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

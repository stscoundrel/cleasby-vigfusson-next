      </li>
      <li>
        <a
          className="link"
          href="/word/smeita"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          smeita
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>fat steam,</i> as from cooking; see smita.",
            }

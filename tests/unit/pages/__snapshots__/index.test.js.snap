          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjaðak
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [Norse <i>skjak</i> = <i>lolium temulentum,</i> Gunnerus Flora Norwagica]:—a kind of <i>weed, darnel;</i> stundum spillir s., of a field, Sks. 322.",
            }
          }
        />

        <a
          className="link"
          href="/word/sneypir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sneypir
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. as a nickname, <i>a snipper (gelder?),</i> Landn. 204.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snidda"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

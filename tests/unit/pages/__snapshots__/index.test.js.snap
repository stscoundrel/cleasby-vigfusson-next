          className="link"
          href="/word/torgu"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          törgu-
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "see targa.",
            }

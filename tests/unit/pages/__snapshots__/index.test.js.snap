        />
      </li>
      <li>
        <a
          className="link"
          href="/word/slaeda"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          slæða
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ð, i. e. <strong>slœða,</strong> [slóð], <i>to trail;</i> fax svá sítt at slæddi jörð, <i>that it trailed along the ground,</i> Sks. 100; hann slæðir fótspor sín með halanum, Stj. 71.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/slaedur"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          slæður
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. pl. <i>a gown, that trails along the ground;</i> s. af silki, pelli, Eg. 516, 702, Fms. iv. 164, vii. 149, viii. 149, Nj. 149, Fs. 51, 52: <i>the train</i> of a lady’s dress, Rm. 26.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/slaefa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          slæfa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to slacken</i> = sljófa, q. v.; slævuðu þær maegður mjök liðveizlu þeirra feðga, Sturl. ii. 61 C.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

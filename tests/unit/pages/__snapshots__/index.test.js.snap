              "__html": "a, m. [for. word], <i>a carbuncle,</i> Flóv.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kardinali"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kardinali

              "__html": "t, [Norse <i>glisa</i>], <i>to grin,</i> Hm. 30, but obsolete in Icel.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/glit"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          glit
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>‘glitter,’</i> used of <i>brocades</i> or <i>rich tissues;</i> ofit í glit af gulli, Gísl. 21; dúkr hálfr með sprang, hálfr með glit, Pm. 123.",
            }

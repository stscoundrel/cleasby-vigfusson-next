        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a hood</i> or <i>bonnet of fur,</i> Ölk. 34; svartr lambskinnskofri, Sturl. ii. 154, Þorf. Karl. 374, N. G. L. i. 211, Vígl. 22.",
            }

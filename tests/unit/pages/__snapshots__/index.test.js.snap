        <a
          className="link"
          href="/word/snar-brekka"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snar-brekka
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a steep brink.</i>",
            }

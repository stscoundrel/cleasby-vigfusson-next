          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ljúgari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a liar,</i> Art.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ljugr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ljúgr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

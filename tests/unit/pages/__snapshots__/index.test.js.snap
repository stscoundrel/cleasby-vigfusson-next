        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to stop, pause, abate;</i> staðnaði orrostan (kurrinn), Fms. i. 34, 386, xi. 224, Ó. H. 69, Stj. 445.",
            }

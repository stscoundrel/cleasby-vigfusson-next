            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thrunginn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þrunginn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>oppressed, stifled,</i> Fas. ii. 124; see þröngva.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thrusk"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

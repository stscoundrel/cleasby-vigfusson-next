          onTouchStart={[Function]}
        >
          þarf-leysa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>needlessness,</i> Gþl. 163; láta þat mart eptir börnum er þ. er, Fb. ii. 13; reikar hugrinn jafnan á því er þ. er í, 655 xi. 3: gen. as adj., þarfleysu-forvitni, -tal, -glens, <i>useless, mischievous,</i> Ld. 170, Fb. i. 312, 400, Grett. 87 new Ed.; þarfleysu upphlaup, Bs. i. 756.",
            }
          }
        />
      </li>
      <li>

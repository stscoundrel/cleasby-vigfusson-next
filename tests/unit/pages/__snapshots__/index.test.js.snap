          dangerouslySetInnerHTML={
            {
              "__html": "adj. [Ulf. <i>hrôþeigs;</i> A. S. <i>hréðig</i>], <i>triumphant,</i> Vkv. 18, Ls. 45: <i>glorious,</i> Gm. 19, Ad. 9, Lex. Poët.: as also in poët. compds, vin-h., al-h.: freq. in mod. usage in the sense of <i>boasting, triumphant.</i>",
            }
          }
        />

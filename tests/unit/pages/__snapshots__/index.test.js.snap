      <li>
        <a
          className="link"
          href="/word/na"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          na
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a suff. demonstr. particle, see Gramm. p. xxxviii, col. 2 (III); esp. freq. in mod. usage in the words hér-na, þar-na, ha-na, nú-na, svá-na (proncd. svo-na or so-na), q. v., Band. 18; as also þér-na, Fms. vi. 422; þat-na, MS. 623. 19; þess-na, Fas. ii. 147; við-na, Fms. iii. 73; gær-na, vi. 254: with verbs rarely, var-na, Fas. ii. 174: part. spurt-na, Fb. i. 433; satt-na, Bs. i. 469, v. l.: and lastly in the pers. pron. ha-nn, hó-n.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/na-lykt"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          na-lykt
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>the smell of a corpse.</i>",
            }
          }
        />
      </li>
      <li>

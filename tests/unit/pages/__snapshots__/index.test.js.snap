          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          embætti
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>embuð,</strong> Anecd. 38), n. [Germ. <i>amt;</i> Dan. <i>embede;</i> as to the root vide ambátt, p. 19], <i>service, office;</i> bjóða e-m af e., <i>to depose one from office,</i> Bs. i. 550; Guðs e., Hom. 121, 160, Stj. 613. 2 Kings iv. 13; mikit e., <i>hard work, a great task,</i> Hom. 153; veita e-m e., <i>to serve one,</i> Fms. viii. 332, 406; bindask í e-s e., <i>to enter one’s service,</i> Sks. 357; fremja e., <i>to perform a service,</i> Bs. i. 426; Guðligt e., <i>holy service,</i> Fms, ii. 198; heilagt skírnar e., <i>holy baptism,</i> i. 148: <i>officiating at mass,</i> D. N.",
            }
          }
        />
      </li>

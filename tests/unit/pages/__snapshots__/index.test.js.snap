        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>want of means,</i> Bs. i. 457.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/efna-lauss"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          efna-lauss
        </a>
        <p
          dangerouslySetInnerHTML={

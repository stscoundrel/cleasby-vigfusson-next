        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>keen, quick;</i> snarlig augu, Fms. i. 102: <i>sprightly,</i> lítill maðr ok s., vi. 416; snarligt ok snöfurligt, Band. 16 new Ed.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snar-lyndr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snar-lyndr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>quick of mind,</i> Skv. i. 43.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snar-radr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snar-ráðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

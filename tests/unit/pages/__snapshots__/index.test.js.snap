          onTouchStart={[Function]}
        >
          róteldi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. = rótakylfa, <i>a ‘root-club,’</i> Fms. xi. 129, v. l.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rubba"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

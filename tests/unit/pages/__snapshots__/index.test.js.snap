          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vigilia"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vigilia
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. [Lat.], <i>a vigil;</i> vigiliu-dagr. Vm. 24.",
            }
          }
        />

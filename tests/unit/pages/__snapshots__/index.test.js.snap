              "__html": "m. <i>a due, tithe,</i> Anecd. 48.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skuldari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skuldari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a debtor,</i> Hom. 5.",
            }

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          huginn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. the wise raven of Odin, Gm., Edda.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hugna"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hugna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to please;</i> e-m hugnar e-t, <i>something pleases one, one likes it, is pleased, satisfied with it;</i> h. vel, ílla, Eg. 395, Lv. 34, Fs. 27, 138, 152, Fas. i. 220, Glúm. 355, 365, Orkn. 14, Korm. 154, Ld. 328, Band. 7 new Ed.: reflex., e-m hugnask e-t, <i>id.,</i> Ld. 50, Ó. H. 43, Eg. 96 (v. l.), Sturl. i. 24, Str. 19.",
            }
          }
        />
      </li>
      <li>

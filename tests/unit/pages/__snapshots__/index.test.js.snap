        />
      </li>
      <li>
        <a
          className="link"
          href="/word/mal-2"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mál
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> n., old pl. m́l, 673. 47, Greg.; [Ulf. <i>maþl</i> = ἀγορά; Hel. <i>mahal</i> = <i>speech, meeting;</i> Dan. <i>maal;</i> from the old Teut. <i>maþl</i> or <i>mahal</i> was formed the mid. Lat. <i>mallum</i> = <i>parliament, public meeting</i> (Du Cange), and <i>mallum</i> again was in Norman-French rendered by <i>parliament</i>.]",
            }
          }
        />
      </li>

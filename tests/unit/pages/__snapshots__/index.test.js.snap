      <li>
        <a
          className="link"
          href="/word/skulda-stadr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skulda-staðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>an investment, deposit of money;</i> gefa fé eðr aðra hluti á skuldarstöðum, Grág. i. 406; játa, taka skuldarstað, Ld. 212, Gþl. 511, Dipl, i. 11, Lv. 46, Fær. 233.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

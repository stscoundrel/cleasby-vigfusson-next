        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dyrgja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dyrgja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> u, f. [durgr], <i>a dwarf woman, a hag,</i> Þjal. Jón. 17.",
            }

              "__html": "qs. <strong>haldsi,</strong> adj. indecl. <i>holding,</i> Fms. x. 396: with dat., haldzi e-u, Þiðr. 172.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ham-dokkr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ham-dökkr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>dark-skinned, of dark hue,</i> Edda (Ht.), of the raven.",
            }

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. [hákr], <i>voraciously, savagely,</i> Róm. 353.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/haekil-bjugr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hækil-bjúgr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>bowed, crouching,</i> Band. 8.",
            }

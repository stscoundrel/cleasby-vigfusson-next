          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          koll-hnís
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [kollr and hnísa = <i>a dolphin,</i> = Dan. <i>kollbötter</i>], <i>a somersault;</i> stingast kollhnís, <i>to make a somersault,</i> a game.",
            }
          }
        />

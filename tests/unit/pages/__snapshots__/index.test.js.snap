          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          spenna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "t, [A. S. <i>spannan</i>], <i>to span, clasp;</i> s. sverð báðum höndum, Fms. viii. 363; spenna árarnar fjórir hverja, 384; á langskipunum spenntu tveir eina ár, ix. 310; spenntu tveir hverja ár, 303, v. l.",
            }

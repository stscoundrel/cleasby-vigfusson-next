          onTouchStart={[Function]}
        >
          vér
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "pers. pron., [Goth. <i>weis;</i> A. S. <i>we;</i> O. H. G. <i>wir</i>; Dan. <i>vi</i>]:—<i>we,</i> passim; see also the forms vær and mér.",
            }
          }
        />
      </li>

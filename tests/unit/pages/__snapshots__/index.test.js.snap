        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj., contr. snúðga, [A. S. <i>snúd</i> = <i>quick, agile</i>], <i>twirling, wheeling;</i> snúðga steini, Gs. 4, 12.",
            }

      <li>
        <a
          className="link"
          href="/word/thras"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þras
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a quarrel, litigation;</i> opt er þras á þingum, Hallgr.: <i>an idle quarrelling;</i> þetta er ljóta þrasið! leiðinda-þras, <i>a tiresome wrangle.</i>",
            }
          }

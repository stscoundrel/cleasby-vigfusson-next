            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/slembra"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          slembra
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a clot;</i> in grautar slembra, <i>a small spoonful of porridge.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/slen"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          slen
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>sloth;</i> nú muntú verða at draga slenit af þér, mannskræfan, Grett. 91: also medic. <i>dullness,</i> slen ok máttleysi, slen og doði.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/slengja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

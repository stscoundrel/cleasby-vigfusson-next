        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. [Dan. <i>spodsk</i>], <i>mocking, jeering.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/spoi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

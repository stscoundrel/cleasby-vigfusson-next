        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>heimull-</strong>), mod. <strong>heimugleikr</strong> (<strong>-leiki</strong>), m. <i>privacy, intimacy;</i> kærleiki með h., Bs. i. 809; h. ok vinátta, Fms. v. 176 (v. l.), Bs. (Laur. S. passim), Mar.",
            }
          }
        />
      </li>

          className="link"
          href="/word/aestiligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          æstiligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>desirable;</i> væn kona ok æstilig, MS. 625. 94: girniligr ok æ., 77.",
            }
          }
        />
      </li>
      <li>

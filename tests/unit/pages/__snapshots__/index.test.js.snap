        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>russet, sad-coloured,</i> of wadmal, Finnb. 318, Fs. 141, Rd. 251; söluváðar-kyrtil mórendan, Nj. 32; mórend vara, Bs. i. 286.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

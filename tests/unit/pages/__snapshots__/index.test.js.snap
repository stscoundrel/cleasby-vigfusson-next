          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fyrnska
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f., prop. <i>age;</i> slitin, fúinn af f., <i>worn, rotten from age,</i> Stj. 366: <i>decay,</i> Grág. ii. 268: at fyrnsku. <i>from olden times,</i> N. G. L. i. 45; í fyrnskunni, <i>in days of yore,</i> Str. 1:—a law term = fyrnd, skal þar eigi f. fyrir ganga, N. G. L. i. 249:—<i>old lore, witchcraft,</i> Fb. i. 231, Fs. 131. <strong>fyrnsku-háttr,</strong> m. <i>old fashion,</i> Fms. xi. 430.",
            }
          }
        />
      </li>

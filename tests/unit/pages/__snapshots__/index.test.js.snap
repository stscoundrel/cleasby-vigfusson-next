          onTouchStart={[Function]}
        >
          iða
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>an eddy, whirlpool,</i> Grett. 141 A; ok muntú finna saman rekit í eina iðu, 623. 37, passim; hring-iða, q. v. <strong>iðu-kast,</strong> n. <i>a whirling eddy,</i> Mag.",
            }
          }
        />
      </li>
      <li>

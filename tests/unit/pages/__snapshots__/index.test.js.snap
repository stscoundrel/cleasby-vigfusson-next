        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>abroad,</i> Fms. iii. 103, Ísl. ii. 118. <strong>útlendis-maðr,</strong> m. <i>a foreigner,</i> Fms. x. 107.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

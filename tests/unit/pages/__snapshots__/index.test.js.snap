        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kveld-mal"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kveld-mál
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>eventide,</i> Fr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kveld-maltid"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kveld-máltíð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. a <i>supper,</i> Fas. iii. 282: eccl. <i>the Lord’s Supper,</i> Germ. <i>Abendmahl,</i> Dan. <i>Nadverd,</i> Swed. <i>Nattvard:</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kveld-rida"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kveld-riða
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>an ‘evening-rider,’ night-hag, witch,</i> riding on wolves in the twilight, Hkv. Hjörv. 15, Hallfred, Lex. Poët.; Þorbjörn stefndi Geirríði um þat at hón væri k., Eb. 46; hón var fjölkunnig, ok hin mesta k., Fas. iii. 650; kveldriðu stóð, <i>the ‘ogress-steed’</i> = <i>the wolves,</i> Hallfr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kveld-rodi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kveld-roði

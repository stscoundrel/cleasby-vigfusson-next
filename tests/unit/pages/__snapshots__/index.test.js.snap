          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snúðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [snúa; Scot. <i>snood</i>], <i>a twift, twirl;</i> það er harðr snúðr, linr snúðr; þeir knýttu saman ok görðu snúða (v. l. snýð = snúð) á endunum, <i>and twirled it into a clew at the ends,</i> Fms. iv. 335 (noða, i. e. hnoða (q. v.), Ó. H. l. c.)",
            }
          }
        />
      </li>

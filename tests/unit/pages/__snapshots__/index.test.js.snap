        />
      </li>
      <li>
        <a
          className="link"
          href="/word/logmanns-eidr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lögmanns-eiðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>an oath of homage to the king,</i> Gþl. 66.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/logmanns-lauss"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lögmanns-lauss
        </a>
        <p
          dangerouslySetInnerHTML={
            {

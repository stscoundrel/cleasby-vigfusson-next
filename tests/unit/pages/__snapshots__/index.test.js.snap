          className="link"
          href="/word/drauga-gangr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drauga-gangr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a gang of ghosts.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drauga-sogur"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drauga-sögur
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. pl. <i>ghost stories</i> in nursery tales, for a collection of such, vide Ísl. Þjóðs. i. 222–354.",
            }
          }
        />

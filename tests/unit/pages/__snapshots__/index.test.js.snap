          onTouchStart={[Function]}
        >
          al-þiljaðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. part., old form <strong>-þilðr,</strong> <i>completely wainscotted,</i> Sturl. iii. 193: the vellum MS. has -þilðir, the Ed. -þiljaðir.",
            }

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>wooden palings, a wooden fence,</i> Eg. 80, 232, Ó. H. 135, Fb. i. 545, Fms. ix. 521; skíðgarðs-hlið, iii. 67: <i>a yard,</i> 656 C. 4.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skid-kjalki"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

          className="link"
          href="/word/skja-grind"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjá-grind
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f., see above.",
            }
          }
        />

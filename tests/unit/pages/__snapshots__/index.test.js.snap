          onTouchStart={[Function]}
        >
          skop
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. = skaup, <i>railing, mocking,</i> Fas. iii. 37. <strong>skop-ligr,</strong> adj.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skopa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

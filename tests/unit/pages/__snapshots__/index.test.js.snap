        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a usurer,</i> K. Á. 206, = Dan. <i>aager karl.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/okra"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          okra
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to practise usury;</i> okra e-u or okra með e-t.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/oktava"

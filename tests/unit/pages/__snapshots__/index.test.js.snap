          dangerouslySetInnerHTML={
            {
              "__html": "n., dat. líkjum, 656 C. 26, Hom. 46, Hom. (St.), Hkr. i. 10, [from lík, not from glíkr]:—<i>a body;</i> líki leyfa ins ljósa mans, Hm. 91; vexa vel blæju at verja þitt líki, Am. 101; þar eptir máttu merkja hans fegrð, bæði hár ok líki, Edda 15; líki fögr, <i>beautiful,</i> Bjarn. (in a verse).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/liking"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          líking
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>líkja,</strong> <strong>líkindi,</strong> <strong>líkleikr,</strong> <strong>líkligr,</strong> see glíking, glíkja, glíkindi, glíkleikr, glíkligr.",
            }
          }
        />

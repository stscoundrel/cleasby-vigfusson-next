          onTouchStart={[Function]}
        >
          vár-kynna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ð, mod. <strong>vorkenna,</strong> qs. kunna vár, see várkunn above:—<i>to excuse;</i> v. e-m, Greg. 72; vil ek yðr v. at þér þykkisk alls til lengi hafa heiman verit, Fms. ii. 296; munu vér eigi várkynna öðrum þó at hér skatyrðisk, Ísl. ii. 384.",
            }
          }
        />
      </li>
      <li>

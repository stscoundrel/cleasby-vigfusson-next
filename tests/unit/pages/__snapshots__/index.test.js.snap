        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. pl. = Sygnir, q. v.; in <strong>Svigna-kappi,</strong> a nickname, Landn.; <strong>Svigna-skarð,</strong> a farm in western Icel.",
            }
          }
        />

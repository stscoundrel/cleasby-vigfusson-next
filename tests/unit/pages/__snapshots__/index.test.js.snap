          onTouchStart={[Function]}
        >
          kanna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a mark</i> on cattle; oxi er hans k. væri á, Fs. 173; allt þat sem þeirra kanna leikr er á, D. N. i. 80, 91, iii. 144; see einkanna and einkunn.",
            }

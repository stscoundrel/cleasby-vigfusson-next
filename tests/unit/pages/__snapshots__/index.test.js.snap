          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          líkn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [lækna is <i>the healing</i> of the body, líkn <i>the soothing</i> of the mind or heart; the words seem to be identical: in very early usage líkn seems to denote <i>bodily healing</i> also, and particularly of <i>relief in labour,</i> hence the words líknar-galdr, -spor, -lófi in the old poems Sdm. and Hm., as also the líknar-belgr, although now only used of the caul of animals]:",
            }
          }
        />

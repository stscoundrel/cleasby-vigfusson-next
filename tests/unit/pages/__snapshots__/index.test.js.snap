          onTouchStart={[Function]}
        >
          van-
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a particle prefixed to nouns and adverbs, [cp. vanr; Goth. and A. S. <i>wan-, deficient;</i> O. H. G. <i>wana-</i>]:—<i>lacking, wanting:</i> only used as a compd except in the phrase, of og van, or það er of sem van, <i>now too much, now too little.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/van-breyttr"
          onClick={[Function]}

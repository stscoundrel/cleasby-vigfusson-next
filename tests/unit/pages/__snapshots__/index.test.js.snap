        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>mighty lucky,</i> Fms. ii. 31, Ld. 170, Eg. 46: compar. hamingju-meiri, Fb. i. 301.",
            }

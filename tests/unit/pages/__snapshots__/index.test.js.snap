          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          brúna-bein
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. <i>the bones of the brow,</i> Sturl. i. 180, Heiðarv. S. (in a verse).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/bruna-mikill"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          brúna-mikill
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>heavy-browed,</i> Eg. 304.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/bruna-sidr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          brúna-síðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>having long overhanging brows</i>. Eg. 304, v. 1.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/bruna-skurdr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          brúna-skurðr
        </a>
        <p
          dangerouslySetInnerHTML={

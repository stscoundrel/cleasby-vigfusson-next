        <p
          dangerouslySetInnerHTML={
            {
              "__html": "= <strong>vættvangr</strong> (?); ok var herranum at komit at hann möndi tekinn verða, ok dvalði hann dauða í vetvingum, <i>he was on the point of being taken, but escaped death for the present,</i> Mart. 123.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/veykr"
          onClick={[Function]}

        />
      </li>
      <li>
        <a
          className="link"
          href="/word/minningar-verdr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          minningar-verðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>memorable,</i> Fms. x. 313.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/minnis-drykkja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          minnis-drykkja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a banquet where there are</i> minni, Bs. i. 728.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/minnis-godr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          minnis-góðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>having a good memory.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/minnis-horn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          minnis-horn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a memorial horn, cup,</i> Fsl. 19.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/minnis-lauss"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          minnis-lauss
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>having a bad memory.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/minnis-leysi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          minnis-leysi
        </a>
        <p
          dangerouslySetInnerHTML={

              "__html": "m. <i>evensong, vespers,</i> MS. 625. 178, Bs. i. 849.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kveld-timi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kveld-tími
        </a>
        <p

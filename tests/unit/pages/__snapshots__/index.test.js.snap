        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>ró-lyndi,</strong> f.), adj. <i>calm of mind,</i> Sturl. i. 8, ii. 185.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ro-samr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ró-samr

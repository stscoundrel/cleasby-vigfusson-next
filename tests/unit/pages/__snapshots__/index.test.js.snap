      <li>
        <a
          className="link"
          href="/word/dag-stingr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dag-stingr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>the ‘day-sting,’ daybreak,</i> Greg. 57, (rare.)",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dag-stjarna"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dag-stjarna
        </a>
        <p
          dangerouslySetInnerHTML={

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>priesthood,</i> 415. 1, Sturl. i. 100, Stj. 241, 251, 301, passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kenning"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kenning
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>doctrine, teaching, lesson,</i> esp. of <i>preaching,</i> Fms. i. 148; kenna kenningar, <i>to teach, preach,</i> 625. 24, K. Á. 22, Bs. i. 140, N. T., Vídal.; tíðagörð ok k., passim; á-kenning, q. v.; viðr-k., <i>acknowledgment.</i>",
            }
          }

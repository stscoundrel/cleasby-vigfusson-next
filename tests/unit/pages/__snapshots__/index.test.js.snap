        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "t, [A. S. <i>clumjan</i>], <i>to maunder, murmur;</i> ok vil ek at þú klymtir nú eigi á móti mér, Háv. 17 new Ed.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klyppr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klyppr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. a pr. name, Fb. iii.",
            }

              "__html": "að, <i>to resound:</i> part. ómandi, <i>sounding, resounding;</i> ómandi stólpa gangr, rendering of Homer’s αἴθουσα ἐρίδουπος.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/omaga-lauss"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

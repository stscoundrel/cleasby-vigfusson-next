        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. [Dan. <i>vissen;</i> Engl. <i>wizened</i>], <i>wizened, withered,</i> also of a limb <i>palsied;</i> var visinn annarr fótrinn, Fms. vii. 239.",
            }

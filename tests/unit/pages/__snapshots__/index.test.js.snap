              "__html": "or <strong>-sætt,</strong> f. <i>a forced agreement,</i> Sturl. iii. 150, Fms. vii. 248, viii. 154, O. H. L. 90.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/naudar-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nauðar-maðr

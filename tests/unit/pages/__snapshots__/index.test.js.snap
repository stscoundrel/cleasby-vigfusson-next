        />
      </li>
      <li>
        <a
          className="link"
          href="/word/smid-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          smið-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. (<strong>-liga,</strong> adv.; A. S. <i>smiðlice</i>), <i>workman-like,</i> Krók.; ó-smiðligr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/smid-reim"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          smið-reim
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>the ‘smith’s edge,’</i> the rim running along the back of a scythe-blade to give it strength; ljár máðr upp í s., Fb. i. 522.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/smid-velar"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

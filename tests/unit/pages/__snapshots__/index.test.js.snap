      <li>
        <a
          className="link"
          href="/word/moask"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          móask
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, dep. [early Germ. <i>mewen;</i> Ivar Aasen <i>tygge mo</i> = <i>ruminate</i>]:—<i>to be digested,</i> of food in the stomach of ruminating animals; sem vánligt var at grasit móaðisk með honum eptir náttúru, Bs. ii. 87.",
            }

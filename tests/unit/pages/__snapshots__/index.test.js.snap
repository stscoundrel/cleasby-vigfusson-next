      </li>
      <li>
        <a
          className="link"
          href="/word/almanna-bygd"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          almanna-bygð
        </a>
        <p
          dangerouslySetInnerHTML={

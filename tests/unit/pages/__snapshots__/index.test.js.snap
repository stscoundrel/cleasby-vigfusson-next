        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. [Germ. <i>diener;</i> Dan. <i>tjener</i>], <i>a servant,</i> (mod. word.)",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thenusta"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þénusta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f., a later form for þjónusta (q. v.), <i>a service,</i> Th. 3, H. E. i. 561.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ther"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

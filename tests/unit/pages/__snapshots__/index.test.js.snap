          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hnýfil-drykkja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a carouse, drinking bout</i> (?); vóru fyrst drukknar sveitar-drykkjur, síðan slógusk í hnýfildrykkjur, Sturl. iii. 126.",
            }
          }
        />
      </li>
      <li>

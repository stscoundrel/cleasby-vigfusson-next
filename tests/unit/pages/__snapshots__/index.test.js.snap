              "__html": "m. <i>‘mist-Tuesday,’</i> i. e. the second Tuesday after Easter, D. N. passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thoku-visur"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þoku-vísur
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "the name of a poem, <i>the Lay of the Mist,</i> Fb. i. 212.",
            }

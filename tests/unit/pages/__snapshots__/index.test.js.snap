        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. and <strong>klofa-stafr,</strong> m. <i>a cleft stick</i> or <i>staff,</i> Bárð. 170, 171; see klafi.",
            }
          }
        />
      </li>
      <li>

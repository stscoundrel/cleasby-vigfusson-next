        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a shelf in a</i> s., Fbr. 88.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skrif"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skrif
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a writ, writing,</i> (mod.)",
            }

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mylna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. [from Lat. <i>mola</i>], <i>a mill,</i> Þiðr. 131, Karl 281, 472, D. N.; the genuine Teut. word is kvern, q. v. <strong>mylnu-maðr,</strong> m. <i>a ‘mill-man,’ miller,</i> Fms. ix. 19.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/mylnari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

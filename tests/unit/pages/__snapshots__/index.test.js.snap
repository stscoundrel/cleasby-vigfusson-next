        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a great king, a sovereign.</i> Ýt., Hðm. 4, Skv. 1. 1, 3. 33, 34, Fms. i. 3; af honum munu margir þ. fæðask, Stj. 115.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thjod-kunnr"
          onClick={[Function]}

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>wretched-looking,</i> Finnb. 280, Háv. 40 new Ed.; lítill vexti ok vesalligr, Fb. i. 540; sakir vesalligra synda, Stj. 51.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

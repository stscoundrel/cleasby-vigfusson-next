        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a trumpeter,</i> Fas. i. 497, Fms. viii. 96, 213, ix. 449, 513.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ludr-theytari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lúðr-þeytari

        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hor-thradr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hör-þráðr
        </a>
        <p
          dangerouslySetInnerHTML={

        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ther-na"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þér-na
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "dat. = þér (see -na), Fms. vi. 422 (= <i>tibi-met</i>).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thera"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þéra
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to address by</i> þér (<i>ye</i>); cp. þúa.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thett-leiki"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þétt-leiki
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>tightness, thickness.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thett-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þétt-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>tight;</i> skipin eigi þéttlig, Fms. ix. 380.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thetta"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

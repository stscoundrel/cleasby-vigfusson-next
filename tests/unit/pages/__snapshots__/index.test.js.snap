        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nauda-mikill"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nauða-mikill
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>very severe,</i> Ísl. ii. 132.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nauda-satt"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nauða-sátt
        </a>
        <p
          dangerouslySetInnerHTML={

          className="link"
          href="/word/leidangrs-gord"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          leiðangrs-görð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>the raising a levy.</i> Fms. vii. 19, Gþl. 75.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/leidangrs-lid"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          leiðangrs-lið
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a levied army,</i> Fms. i. 62, Ó. H. 154. Fær. 79, Orkn. 68.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/leidangrs-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          leiðangrs-maðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

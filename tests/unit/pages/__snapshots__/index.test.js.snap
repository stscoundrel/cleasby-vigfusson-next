        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>without swagger</i> or <i>cant,</i> Mag.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skjal-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjal-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>documentary, authentic;</i> skjalligt próf, D. N. ii. 580.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skjal-semi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

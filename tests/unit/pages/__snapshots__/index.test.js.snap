            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aldr-lag"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          aldr-lag
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>laying down of life, death, destruction,</i> a poët. word, in the phrase, verða e-m at aldrlagi, <i>to bring to one’s life’s end,</i> Fms. viii. 108, Al. 106; esp. in pl. aldrlög, <i>exititim,</i> Bret. 59, 66, 67.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aldr-lok"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          aldr-lok
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. <i>close of life, death,</i> Hkv. 2. 10.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aldr-mali"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

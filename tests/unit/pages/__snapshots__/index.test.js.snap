            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/oskr-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          öskr-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>horribly, hideously;</i> hann (the bull) fór beljandi um völlinn ok lét öskrliga, Eb. 118 new Ed.; æpa ö., <i>to yell hideously,</i> Fb. i. 417, ii. 26.",
            }
          }
        />
      </li>

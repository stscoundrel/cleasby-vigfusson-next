          onTouchStart={[Function]}
        >
          innan-vátr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>‘in wet;’</i> hafa innanvátt, a naut. term, <i>to have the sea washing over,</i> Fær. 256; þeir fengu mjök innanvátt, <i>they had a wet passage,</i> Háv. 48.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/innan-verdr"

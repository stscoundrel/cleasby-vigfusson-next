          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hæla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>hœla</strong>), d, [hól], <i>to praise, flatter,</i> with dat., Eb. 164; hrósa ok hæla e-u, Karl. 438: <i>to glory, boast,</i> hann hældi, at Haraldr hefði hefnt Gamla, Fms. i. 48; eigi má ek af því hæla, Lv. 10, passim.",
            }
          }
        />
      </li>
      <li>

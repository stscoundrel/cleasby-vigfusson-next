        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. (snjó-kökkr), <i>a snowball,</i> Fms. vii. 230, Dropl. 22.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sara-menn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sára-menn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "= sárir-menn, Sturl. ii. 97; cp. <strong>sár-menn,</strong> m. pl., Bær. 19.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sara-syki"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sára-sýki
        </a>
        <p
          dangerouslySetInnerHTML={
            {

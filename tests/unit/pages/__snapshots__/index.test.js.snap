        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thrinnr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þrinnr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "= þrennr, like tvinnr for tvennr; s<i>inn,</i> þr<i>inn</i>um, Rekst.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thriskja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þriskja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "t, <i>to thresh,</i> Fms. viii. 96; the mod. form is <strong>þreskja,</strong> q. v., Dan. <i>tærske;</i> but in Icel. the word is little used, and hardly known, except it be in metaph. phrases.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thristr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

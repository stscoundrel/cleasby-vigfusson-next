          href="/word/fotar-bragd"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fótar-bragð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>‘foot-braid,’</i> a wrestling term, vide bragð. Fas. ii. 370.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/fotar-mein"
          onClick={[Function]}

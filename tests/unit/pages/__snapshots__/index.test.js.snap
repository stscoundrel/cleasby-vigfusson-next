          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snyðja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "snyð, snuddi, a def. verb; [A. S. <i>snyðjan;</i> Ivar Aasen <i>snydia;</i> Engl. <i>sniff</i>]:—perh. prop. <i>to go sniffing,</i> a metaphor from hounds; hann fór snyðjandi at leita Þórólfs, <i>he went sniffing in search of Th.,</i> Fs. 50.",
            }
          }
        />

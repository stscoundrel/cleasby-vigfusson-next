          className="link"
          href="/word/rykki-lin"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rykki-lín
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a priest’s surplice,</i> spelt rykkjulín, Bs. ii. 248.",
            }

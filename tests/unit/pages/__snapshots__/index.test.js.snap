        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>fair about one’s share, upright, honest,</i> Band. 35 new Ed., Lv. 48, Thom. 396, Rétt. 5. 5: ó-hlutvandr, <i>dishonest.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-verk"

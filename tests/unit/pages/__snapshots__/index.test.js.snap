      </li>
      <li>
        <a
          className="link"
          href="/word/murra"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          murra
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to murmur,</i> Stj. 238, 291.",
            }

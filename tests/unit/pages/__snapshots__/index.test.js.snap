              "__html": "v. dafla.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dam-godr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dám-góðr
        </a>
        <p
          dangerouslySetInnerHTML={

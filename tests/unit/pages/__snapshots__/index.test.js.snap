            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kennslu-piltr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kennslu-piltr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a school-boy,</i> Bs. i. 792.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kenpa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kenpa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a champion;</i> see kempa.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/keppa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          keppa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "t, [kapp], <i>to contend, strive hard,</i> Am. 54, 61; keppa um e-t, Fms. iii. 214, Grág. i. 410; ef tveir menn keppa um einn hlut, Fb. i. 150; keppa við e-n, <i>to contend with one,</i> Nj. 29, Hkr. iii. 264.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/keppi-kefli"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          keppi-kefli
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a thing worth fighting for:</i> in the phrase, það er ekkert k., <i>it is not worth having,</i> metaphor prob. from the lagakefli, q. v.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

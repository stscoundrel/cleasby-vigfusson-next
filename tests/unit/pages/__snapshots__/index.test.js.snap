          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          húð-skór
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a shoe of a raw hide,</i> Hbl. 35.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hud-stroka"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          húð-stroka
        </a>
        <p
          dangerouslySetInnerHTML={

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          yngvi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>Ynguni</strong> (qs. Yngwini), <strong>Yngvarr,</strong> pr. names; cp. <strong>Yngvöldr,</strong> the name of a woman, Landn.; Yngva ætt, Yngva þjóð, <i>the family, people of Y.,</i> i. e. <i>the Swedish people,</i> Ýt.",
            }

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hreppa-mal"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hreppa-mál
        </a>

          dangerouslySetInnerHTML={
            {
              "__html": "u, f. a <i>‘bee-fly,’ bee,</i> Edda 12, Stj. 91, 210, etc.; <strong>bý-flygi,</strong> n. id., Bs. i. 210, Stj. 411.",
            }

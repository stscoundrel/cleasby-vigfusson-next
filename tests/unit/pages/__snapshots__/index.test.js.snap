          dangerouslySetInnerHTML={
            {
              "__html": "f. pl. <i>London;</i> í Lundúnum, <i>in London:</i> also <strong>Lundúna-borg,</strong> passim: <strong>Lundúna-bryggja,</strong> <i>London-bridge,</i> Ó. H.",
            }
          }
        />

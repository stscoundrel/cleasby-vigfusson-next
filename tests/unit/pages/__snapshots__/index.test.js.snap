            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/fox"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fox
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [A. S. and Engl. <i>fox;</i> Dutch <i>vos;</i> Germ. <i>fuchs;</i> this word occurs in the old northern tongues only in a metaph. sense, and even then rare and obsolete]:—<i>a fraud</i> in selling, <i>adulteration;</i> fox er íllt í exi, Eg. 184 (in a verse); otherwise only in the phrase, selja e-m fox né flærð, Gþl. 492; kaup-fox, veð-fox (q. v.), <i>fraud in sale</i> or <i>bailing,</i> Gþl.",
            }
          }
        />
      </li>
      <li>

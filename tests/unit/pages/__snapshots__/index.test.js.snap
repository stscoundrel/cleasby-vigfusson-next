          dangerouslySetInnerHTML={
            {
              "__html": "m. pl. [A. S. <i>fácen-stafas</i>], <i>banes, evils,</i> Gm. 12, Fas. i. (in a verse): <i>baleful runes,</i> Sl. 60.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/feikna-lid"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

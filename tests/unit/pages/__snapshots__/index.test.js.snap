        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n., Ivar Aasen <i>laft</i> = <i>the coin</i> or <i>joint in a wooden building,</i> D. N. passim; cp. lopt. <strong>laft-steinn,</strong> m. <i>a</i> laft <i>stone,</i> D. N.",
            }
          }
        />

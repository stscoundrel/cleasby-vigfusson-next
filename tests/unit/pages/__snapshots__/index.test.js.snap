          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skoppa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, (<strong>skopp,</strong> n.), [cp. Engl. <i>to skip</i>], <i>to spin like a top.</i> <strong>skoppara-kringla,</strong> u, f. <i>a top</i> (the toy).",
            }
          }
        />
      </li>
      <li>

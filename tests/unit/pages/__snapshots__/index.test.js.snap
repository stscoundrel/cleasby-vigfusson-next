        <a
          className="link"
          href="/word/ut-messa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          út-messa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>service in the afternoon,</i> opp. to high mass, Fms. x. 163.",
            }
          }
        />
      </li>

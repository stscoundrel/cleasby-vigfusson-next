        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [Engl. <i>heel</i>, cp. Lat. <i>calx:</i> this is a Scandin. word, for the A. S. term is <i>hóh,</i> the Goth. <i>fairzna,</i>, the Germ. <i>fersen</i>]:—<i>the heel,</i> Bs. i. 423, Hým. 34, N. G. L. i. 339, Stj. 37, passim.",
            }
          }
        />

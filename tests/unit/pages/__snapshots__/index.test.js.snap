          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ynglingr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m., mod. <strong>unglingr,</strong> [Dan. <i>yngling;</i> Germ. <i>jüngling</i>], <i>a young person, youth,</i> Karl. 152.",
            }

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "indecl. <i>‘ten-ty,’</i> i. e. <i>one hundred:</i> the older form is tíu tigir; see tigr.",
            }
          }
        />
      </li>
      <li>

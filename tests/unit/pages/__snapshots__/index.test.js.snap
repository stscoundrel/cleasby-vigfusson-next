        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. part. [A. S. <i>eâðbede</i>], <i>easily persuaded to do</i> a thing, with gen. of the thing, Eg. 17, 467.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aud-baettr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

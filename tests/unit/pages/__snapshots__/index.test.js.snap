        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. [Engl. <i>spoke</i>], <i>a small spoke, piece of wood;</i> dreng-spóki, <i>a ‘boy-spoke’, an imp.</i> Grönd.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

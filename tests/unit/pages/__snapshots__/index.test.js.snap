          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vagl
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [Ivar Aasen <i>vagl;</i> Swed. <i>vagel</i> = <i>a roost</i>]:—<i>a beam,</i> esp. <i>an upper cross-beam, roost;</i> hann hljóp í þvertré á húsinu ok síðan á vaglinn ok af vaglinum ok út í glugginn, Fms. x. 290.",
            }

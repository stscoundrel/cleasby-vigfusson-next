          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skil-ríkliga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>clearly, conclusively,</i> Gþl. 18 (Jb. 48), Karl. 554; <i>frankly,</i> H. E. i. 487.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

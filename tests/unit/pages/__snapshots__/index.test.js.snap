          onTouchStart={[Function]}
        >
          skil-fengin
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. f. <i>lawfully wedded;</i> móðir s., Gþl. 215, 232; s. kona, N. G. L. i. 151; s. barn = skilgetið barn, Rétt. 44; dróttningar skilfenginnar, Fms. vii. 306.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skil-getinn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skil-getinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>lawfully begotten, born in wedlock; s.</i> sonr, dóttir, arfi, Nj. 154, Orkn. 318, Fms. ix. 242, 328, Vm. 131:—s. móðir, = skilfengin, N. G. L. ii. 75. v. l. 17.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

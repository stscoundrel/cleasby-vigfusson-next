          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mál-leysa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a sentence which has no meaning;</i> það er m., <i>‘tis no sense,</i> of bad grammar or the like: <i>of bad rhyme,</i> gröm skömm … hrömm skömm, þat væri jafnhátt, en hitt er m., Fms. vi. 386.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/mal-leysi"

      <li>
        <a
          className="link"
          href="/word/mygla"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mygla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> að, [mugga], <i>to grow muggy</i> or <i>musty;</i> en er minnþakit tók at mygla, Landn. 34; myglat brauð, Stj. 367; myglaðr ostr, myglað hey, and the like.",
            }
          }
        />
      </li>
      <li>

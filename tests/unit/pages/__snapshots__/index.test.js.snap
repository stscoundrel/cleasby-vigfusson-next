              "__html": "u, f. <i>cock-crow,</i> N. G. L. i. 9.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hand"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

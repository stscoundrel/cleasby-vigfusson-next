          onTouchStart={[Function]}
        >
          stubbi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. (stobbi), <strong>stubbr,</strong> O. H. G. 79, [Engl. <i>stub</i>], <i>a stub, stump,</i> Grett. 84; þann litla stubbinn er eptir var tungunnar, Ó. H. l. c.; með þeim stubba, Karl. 511, v. l.; árar-stubbi, <i>an oar stump,</i> Ísl. ii. 83; tré-s., kertis-s.",
            }
          }
        />
      </li>
      <li>

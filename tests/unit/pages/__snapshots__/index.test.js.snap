          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tyrrinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>peevish, fretful,</i> Grett. 111; ú-tyrrinn, <i>peaceful,</i> Gísl. (in a verse).",
            }
          }
        />
      </li>
      <li>

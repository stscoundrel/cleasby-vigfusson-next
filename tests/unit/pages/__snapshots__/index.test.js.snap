            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snarp-leikr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snarp-leikr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>-leiki</strong>), m. <i>roughness;</i> afl trésins ok s. næfra, <i>the roughness of the bark,</i> 677. 14: <i>severity,</i> s. frosts, Mar.; s. hirtingar, H. E. i. 404, Bs. i. 276: <i>a dash,</i> s. í orrostum, Fms. ii. 107.",
            }
          }
        />
      </li>
      <li>

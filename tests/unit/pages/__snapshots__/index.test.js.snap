        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. = greiði, N. G. L. ii. 431: <i>a furtherer,</i> Lex. Poët.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/greidka"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          greiðka

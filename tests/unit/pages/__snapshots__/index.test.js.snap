      <li>
        <a
          className="link"
          href="/word/opin-skar"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          opin-skár
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>lying open, manifest,</i> as also metaph. <i>out-spoken, frank.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

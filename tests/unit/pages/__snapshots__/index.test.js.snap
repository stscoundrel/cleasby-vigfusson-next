        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>an ascetic,</i> Bs. ii. 146; mod. <i>a teetotaler.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

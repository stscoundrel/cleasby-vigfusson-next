          className="link"
          href="/word/tjald-kula"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tjald-kúla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. a <i>‘tent-ball,’ tent-knob,</i> the knob on the tent-pegs; þeir berja þeim tjaldkúlur ok fella á þá tjöldin, Ísl. ii. 56, Fas. ii. 522, Fb. ii. 16.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tjald-lauss"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tjald-lauss
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>tentless, in open air</i>, Fms. ix. 300, x. 135, v. l.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tjald-leppr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>furiously, madly,</i> Fbr. 173, Gísl. 49.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aeri-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          æri-ligr

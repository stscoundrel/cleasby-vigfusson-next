            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/lektari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lektari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. [eccl. Lat. <i>lectorium</i>], <i>a lectern, reading desk,</i> Vm. 10, 52, Dipl. v. 18, Bs. i. 797.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/lektia"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lektía
        </a>
        <p
          dangerouslySetInnerHTML={
            {

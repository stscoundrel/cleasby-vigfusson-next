      <li>
        <a
          className="link"
          href="/word/spraka"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          spraka
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> u, f. <i>a little flounder.</i>",

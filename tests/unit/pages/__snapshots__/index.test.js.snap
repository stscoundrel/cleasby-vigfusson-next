          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          túlkr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [a Slavon. word; Lett. <i>tulkas</i>], <i>an interpreter, spokesman,</i> in a foreign language, Ld. 76, Orkn. 330, Fms. iii. 33, vii. 192, xi. 300, Stj. 542: <i>a broker,</i> þeir brakkernir er vér köllum túlka, Fms. v. 183 (Fb. ii. 138): <i>a spokesman,</i> Stj. 157.",
            }
          }
        />

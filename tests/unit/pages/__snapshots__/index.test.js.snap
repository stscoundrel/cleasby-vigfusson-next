        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hyl-bauti"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hyl-bauti
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>‘depth-beater,’</i> poët. <i>a ship</i>, Edda (Gl.)",
            }

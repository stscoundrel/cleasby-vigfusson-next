        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skikkju-skaut"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skikkju-skaut
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>the lap of the</i> s., Fms. iv. 137, Mag.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skil"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skil
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. [skilja; Engl. <i>skill;</i> Dan. <i>skjel;</i> a word borrowed from the Norse]:—<i>a distinction,</i> of eyesight and hearing; menn sá varla handa sinna skil, <i>one could hardly distinguish one’s own hands,</i> Eb. 260; sjá varla fingra sinna skil, Bs. i. 352; nema orða-skil, <i>to catch the distinction of words,</i> Eb. 28; kunna daga-skil, Sks.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

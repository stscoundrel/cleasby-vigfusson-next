        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a muster, ‘tale of men,’</i> Grág. i. 66, N. G. L. i. 97; skora m., <i>to muster troops,</i> Ó. H. 203, Stj. 456: <i>a census,</i> at manntali, <i>by tale,</i> Bær. 6: Grág. ii. 381.",
            }
          }
        />

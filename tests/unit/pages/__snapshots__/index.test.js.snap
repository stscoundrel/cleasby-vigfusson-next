          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kalekr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m., Fms. iii. 28, vii. 198, Dipl. ii. 11, Fs. 115, Bs. i. 76; <strong>kalíkr,</strong> Hom. 139, B. K. 83; mod. <strong>kaleikr,</strong> <i>the chalice,</i> Matth. xxvi. 27, Mark xiv. 23, Luke xxii. 20, 1 Cor. xi. 24–27, Vídal. passim; see kalkr below.",
            }
          }
        />

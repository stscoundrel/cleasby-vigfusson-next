        />
      </li>
      <li>
        <a
          className="link"
          href="/word/reyfi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          reyfi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [akin to A. S. <i>reâf;</i> Engl. <i>robe</i>]:—<i>a fleece,</i> the wool without the skin (but with the skin gærra, q. v.), 655 viii. 1, Stj. 279, Sturl. i. 159, Js. 78, Grág.; ullar-r., K. Þ. K. 84, Grág. ii. 401, passim in old and mod. usage: = gæra, Bret. ch. 7.",
            }
          }
        />
      </li>

        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dag-sanna"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dag-sanna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>true as day,</i> Nj. 73, Fær. 169, Fas. i. 24, cp. Eb. 60.",
            }

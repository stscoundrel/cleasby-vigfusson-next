            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/muli"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          múli
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. [mid. H. G. <i>mûl</i>; Germ. <i>maul</i>], prop, <i>a muzzle, snout</i> (= trjóna), whence <i>the mouth</i> of beasts; göltr með járnuðum múla, of a war-engine, Sks. 395; búinn múlinn með járni, Róm. 292; harð-múla, <i>hard-mouthed.</i> Germ. <i>hart-mäulig;</i> kol-múlugr, <i>black-mouthed:</i> <strong>múlaðr,</strong> adj. = Lat. <i>rostratus:</i> <strong>múla-stykki,</strong> n. <i>a smith’s vice,</i> Vm.; korna-múli, a nickname, Landn.",
            }
          }
        />
      </li>
      <li>

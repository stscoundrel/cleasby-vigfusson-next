        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ja, m. a <i>wretch,</i> in Icel. in a compassionate sense; Guðs a., 655 xxxii. 15, Bs. i. 74, Hom. 87.",
            }
          }
        />
      </li>
      <li>

          href="/word/haegd"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hægð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [hog-], <i>ease, facility;</i> með hægð, <i>with ease, easily:</i> in pl. hægðir, medic. <i>stools,</i> <strong>hægðar-leikr,</strong> m. <i>an easy game;</i> það er enginn hægðarleikr, <i>‘tis no easy game.</i>",
            }
          }
        />
      </li>
      <li>

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a giving a meal,</i> K. Þ. K. 88.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/verd-hald"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

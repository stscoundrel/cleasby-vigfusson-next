      <li>
        <a
          className="link"
          href="/word/tima-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tíma-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>timely, early,</i> Stj. 184.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tima-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tíma-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>temporal,</i> Stj. 3.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tima-samliga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tíma-samliga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>successfully,</i> Fær. 108.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tima-skipti"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tíma-skipti
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>change of time</i> (gramm.), Skálda 206.",
            }

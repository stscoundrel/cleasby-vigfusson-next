        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>oppressed,</i> Pr. 451.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/throngd"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þröngð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. = þröng; eptir þat slitu þeir þröngðinni, Vápn. 17.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thronging"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þrönging
        </a>
        <p
          dangerouslySetInnerHTML={

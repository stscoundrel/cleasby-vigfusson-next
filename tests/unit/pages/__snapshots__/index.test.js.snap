        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. (an error for -my<i>r</i>kr, for mistr is spelt with <i>i</i>, not <i>y</i>?), <i>fog-mist,</i> Mar. 1051.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thoku-samr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

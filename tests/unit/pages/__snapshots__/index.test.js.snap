        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>meddlesome,</i> Fms. ii. 68, Lv. 27, Karl. 386.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-seigr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hlut-seigr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>holding fast one’s share, tenacious,</i> Bs. i. 716.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hlut-semi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

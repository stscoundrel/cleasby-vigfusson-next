        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>archives.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skjala-vordr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjala-vörðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a keeper of archives;</i> leyndar-skjal, <i>a secret deed.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

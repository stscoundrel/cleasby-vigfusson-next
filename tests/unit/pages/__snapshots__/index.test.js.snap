          onTouchStart={[Function]}
        >
          tá-hreinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. (qs. tár-hreinn?), <i>quite clean,</i> e. g. of linen, clean from the mangle.",
            }
          }
        />
      </li>
      <li>

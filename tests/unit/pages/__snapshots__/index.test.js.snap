          onTouchStart={[Function]}
        >
          skot-henda
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a half rhyme</i> (as in l<i>an</i>d l<i>en</i>da), Edda (Ht.) 135, 139; in the old dróttkvæði the half rhyme was used in the odd lines, but aðal-henda (<i>a full rhyme</i>) in the even.",
            }

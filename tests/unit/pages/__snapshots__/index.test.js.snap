            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/inni-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          inni-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>exactly;</i> muna i., <i>to recollect exactly,</i> Sks. 236; at þelta sé i. skilat, 685; skýra e-t i., 487; segja i. (<i>minutely</i>) frá, Fms. x. 371, Ld. 282; marka örn á baki honum sem inniligast, <i>nicely, exactly,</i> Fas. ii. 292.",
            }

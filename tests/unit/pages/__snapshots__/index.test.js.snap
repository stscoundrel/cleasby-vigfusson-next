          onTouchStart={[Function]}
        >
          vand-fenginn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. (also spelt <strong>vannfenginn</strong>), <i>difficult to get,</i> or <i>requiring careful thought to choose;</i> þykkir oss vandfengit manns í stað þinn, Ld. 32; eru yðr vannfengnir hér menn yfir til forráða, Eg. 50, v. l.; vannfenginn mun mér sessu-nautr ef vit skiljum, Ó. H. 52.",
            }
          }
        />

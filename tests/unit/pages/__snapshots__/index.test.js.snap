            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/urdar-kottr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          urðar-köttr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a wild cat</i> = hreysi-köttr, a nickname, Finnb.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/urdar-lokur"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          urðar-lokur
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. pl. (also varðlokur or varðlokkur), <i>‘weird-spells,’ charms,</i> Gg. 7.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/urdar-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          urðar-maðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a man of the</i> urð, <i>an outlaw;</i> göra e-n at urðar-manni, Eg. 728.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/urdar-magn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          urðar-magn
        </a>

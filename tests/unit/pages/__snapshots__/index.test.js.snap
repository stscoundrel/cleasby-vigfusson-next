      </li>
      <li>
        <a
          className="link"
          href="/word/laekn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lækn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a cure,</i> = lækning; koma til læknar, Hkr. i. 102, Post. 248; þeir er vilja læknar lifa (lyfa?), Hm. 148.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/laekna"
          onClick={[Function]}

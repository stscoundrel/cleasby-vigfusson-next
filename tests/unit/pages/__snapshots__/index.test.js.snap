        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. = sviða 2; brunnu skógar viða um hraunit, ok er þat nú kallat á Sviðningi, Ölk. 34.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

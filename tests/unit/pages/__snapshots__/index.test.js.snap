          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sveifla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> að, <i>to swing</i> or <i>spin in a circle,</i> like a top; s. sverði, exi, Nj. 56, 97, Eg. 80, Fas. i. 415, Fbr. 209, Ó. H. 222.",
            }
          }
        />

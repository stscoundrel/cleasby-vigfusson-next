            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/feikn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          feikn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [A. S. <i>fæcen</i>], <i>portent,</i> Skv. 3. 31, Landn. 153 (in a verse); in compds <strong>feikna-</strong> denotes <i>portentous, immense.</i>",
            }

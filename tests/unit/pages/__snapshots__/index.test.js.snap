        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. pl. <i>parings;</i> hákarls-r., fisk-r.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rugga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rugga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> að, <i>to rock a cradle,</i> with dat., Fms. iii. 178; r. barni.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ruggi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ruggi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. a nickname, Landn. 196.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rugl"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rugl
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [Dan. <i>vrövl?</i>], <i>a disturbance,</i> H. E. i. 387, Bs. ii. 3: <i>twaddle.</i>",
            }
          }
        />
      </li>
      <li>

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          bretta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "tt. [brattr], <i>to turn upwards;</i> b. halann, Hkv. Hjörv. 20; cp. bera halann bratt: in mod. use of the clothes, sleeves, etc., <i>to fold up;</i> b. nefið, brýrnar: hence <strong>brettur,</strong> f. pl. <i>comical contortions of the face.</i>",
            }
          }
        />
      </li>

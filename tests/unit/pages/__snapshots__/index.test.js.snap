        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a boy’s game,</i> Hkr. i. 46, Eg. 189.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sveins-ligr"

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          spjallr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>spoken;</i> in opin-spjallr, q. v.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

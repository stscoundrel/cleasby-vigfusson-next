          onTouchStart={[Function]}
        >
          sveitar-höfðingi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>the captain of a</i> sveit (I. 1), Eg. 272, 280, Ó. H. 205, Fms. vii. 259, Orkn. 476.",
            }

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snúin-brók
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>‘twisted-tartan.’</i> a nickname of a lady, Landn.: <strong>snúin-brúni,</strong> a, m. <i>‘twirl-eyelash,’</i> a nickname, Sturl.",
            }
          }
        />

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thorm-samliga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þörm-samliga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "= þörfsamliga. Fms. xi. 146.",
            }

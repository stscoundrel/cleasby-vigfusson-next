          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          jungr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>young</i> (= ungr); this Germanized form is freq. in some MSS. of the 14th and 15th centuries (see Fb. pref. xxii), as also in ballads (rímur) of that time (Skíða R. 199, Þrymlur 7), but was afterwards disused, and never took root in the spoken language.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

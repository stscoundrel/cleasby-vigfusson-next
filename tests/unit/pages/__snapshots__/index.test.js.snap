        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dal-verpi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dal-verpi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a little dale,</i> Nj. 132, Fms. vi. 136, Al. 41. <strong>damma,</strong> u, f. [domina], <i>a dame,</i> Fr. (for. and rare); hence in mod. use madama, <i>madame.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dala"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dala
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to be dented;</i> dalaði ekki né sprakk, Eg. 769, cp. Fas. iii. 12 (the verse).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dallr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dallr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

        />
      </li>
      <li>
        <a
          className="link"
          href="/word/typpingr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          typpingr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [toppr], a kind of <i>lace</i> or <i>edging;</i> dúkar með typping, Vm. 52, 65, 125; typpings-dúkr, 62; typpings-ver, <i>a case of</i> typping, D. N. i. 590.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/typta"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "= tal-byrðingr (q. v.), see Rb.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tafl-fe"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tafl-fé

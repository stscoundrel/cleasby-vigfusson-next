          dangerouslySetInnerHTML={
            {
              "__html": "<strong>dýfliza,</strong> u, f. <i>a dark dungeon,</i> Al. 94, Fms. i. 258, iii. 89, vi. 164, Eluc. 12, 42, Sks. 457, Þiðr. 63, Grett. 158. Fagrsk. 111: [no doubt a foreign word, perhaps from ‘diabolus’ = <i>the dungeon of hell.</i>]",
            }
          }
        />

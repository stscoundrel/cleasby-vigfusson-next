          onTouchStart={[Function]}
        >
          hætta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> t, <i>to risk, stake</i>, with dat., Hm. 106; hætta út mönnum sínum, Sd. 153; hætta til þess virðing þinni, <i>to stake thy honour on it,</i> Eg. 719; hættið þit ok mestu til hversu ferr, Nj. 49; litlu hættir nú til, <i>there is but small risk,</i> Fms. vi. 243: absol., hefir sá er hættir, <i>he wins who risks, ‘nothing venture nothing have,’</i> Bjarn. 7, Hrafn. 16.",
            }
          }
        />
      </li>
      <li>

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fetta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "tt, [fattr], <i>to bend back</i>; fetta fingr, <i>to bend the fingers back;</i> fetta fingr úti e-t, <i>to criticise</i> (<i>unfairly</i>); vide fingr.",
            }
          }
        />
      </li>

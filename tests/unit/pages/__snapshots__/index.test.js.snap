          href="/word/slekt"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          slekt
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [Dan. <i>slægt;</i> from Germ. <i>ge-schlecht</i>], <i>kind, order;</i> riddara-slekt, Edda (pref.), Bs. ii. 10, 122; konungs garðs s., Stj. 1; ef eg skal dæmdr af Danskri slekt, | og deyja svo fyrir Kongsins mekt, Jón Arason; the word is unclass.",
            }
          }
        />
      </li>
      <li>

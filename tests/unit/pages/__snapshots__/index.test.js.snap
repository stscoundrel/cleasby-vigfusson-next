              "__html": "also spelt <strong>rangyndi,</strong> n. pl. <i>unrighteousness,</i> Nj. 142, Eg. 350, Fms. vi. 27, ix. 330, x. 402, N. G. L. i. 125, Al. 34, Bær. 16, Fs. 36, passim.",
            }

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          efan-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>ifan-ligr</strong>), adj. <i>doubtful,</i> Skálda 188, Ld. 58, Fms. x. 317, 369 (in the last two passages spelt with <i>i</i>).",
            }
          }

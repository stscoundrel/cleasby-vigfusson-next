      <li>
        <a
          className="link"
          href="/word/lag-faera"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lag-færa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ð, <i>to mend, put right.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

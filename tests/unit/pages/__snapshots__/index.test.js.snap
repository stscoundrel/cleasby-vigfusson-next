          dangerouslySetInnerHTML={
            {
              "__html": "n., also <strong>þeyja,</strong> u, f. [<strong>þegja</strong>], <i>one’s silent mood;</i> in phrases such as, í þeyi niðri, or í þeyju sinni, or í kyrr-þey, <i>quietly, silently.</i>",
            }

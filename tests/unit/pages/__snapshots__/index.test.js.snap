          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a man of honour, importance, distinction,</i> Nj. 40, Fms. i. 85; s. ok fuilhugi, vii. 150, Fs. 23; hón var hæfilát ok sink, en þó s., Sturl. iii. 169, Sks. 280.",
            }
          }
        />
      </li>

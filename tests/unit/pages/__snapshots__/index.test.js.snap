        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. <i>feats of playing;</i> t. Úlfs jarls, Fb. ii. 283; eigi skildi minna glímu þeirra en tafl-brögð, Vígl. 17.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tafl-byrdingr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tafl-byrðingr

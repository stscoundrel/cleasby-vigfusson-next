        />
      </li>
      <li>
        <a
          className="link"
          href="/word/greidr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          greiðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. [cp. North. E. <i>gradely</i>], <i>ready, free;</i> vísa e-m á greiða götu, <i>to lead one in the straight path,</i> Fms. i. 304; lá honum þat greitt fyrir, <i>it was ready at hand,</i> Fær. 257; verða má, at leiðin verði eigi svá greið sem þeir ætla, <i>that the passage will not be so free as they think,</i> Sturl. i. 18: as adv., skip þat fór greitt, <i>that ship speedeth well,</i> Clem. 38; it greizta, 45; hit greiðasta, <i>straight, with good speed,</i> Fms. i, 292; hann er góðr ok greiðr (<i>expedite</i>) við alla sína nágranna, Band. 3; g. ok góðviljugr, D. N. i. 88; úgreiðr, <i>unready, entangled.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

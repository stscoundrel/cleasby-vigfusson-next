        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>land-owning,</i> Hkr. ii. 206: mod. <strong>landar-eign</strong> (sic), <i>the land, fields, and pasture belonging to an estate:</i> í landareigninni, <i>within the borders of an estate</i> and the like.",
            }

          className="link"
          href="/word/naut-daudr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          naut-dauðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a cattle-plague,</i> Ann. 1187.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/naut-fall"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          naut-fall
        </a>
        <p
          dangerouslySetInnerHTML={
            {

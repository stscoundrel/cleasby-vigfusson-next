        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vakr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vakr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> adj. vökr, vakrt, the <i>r</i> being radical; [Dan. <i>vakker;</i> Swed. <i>vacker</i> = <i>handsome;</i> Germ. <i>wacker</i>]:—<i>wakeful, watchful, alert;</i> ven þú þik æ sem vakrastan, Sks. 24; vakrir gegn allri freistni, Hom. 58; vakr í bænahaldi, Barl. 156; veri þér vakrir (vakkrir Cod.) ok minnisk kenninga þeirra, er …, 655 xiv. B. 2; vakrir í Guðs hræzlu, Greg. 35; inn vakri freistari, Stj. 144; ár-vakr, q. v.",
            }
          }
        />
      </li>

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj.; vera s., <i>to be one who gives good scratches, dangerous,</i> Fb. i. 352, 566, 571, Vígl. 29.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skeinu-samr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skeinu-samr

      </li>
      <li>
        <a
          className="link"
          href="/word/hanki"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hanki
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. [Dan. <i>hanke;</i> Engl. <i>hank</i>], <i>the hasp</i> or <i>clasp</i> of a chest, Fs. 132; naut. <i>pullies</i> or <i>blocks</i> for brailing up a sail, N. G. L. i. 101; whence <strong>hanka-gjald,</strong> n., 199.",
            }

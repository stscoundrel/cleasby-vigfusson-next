        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>tackle (harness) of walrus-hides,</i> Fms. vi. 147, viii. 440, Dipl. v. 18.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/svard-reipi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          svarð-reipi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a rope of walrus-hide,</i> Sks. 184, Bárð. 169.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

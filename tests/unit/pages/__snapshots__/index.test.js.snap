              "__html": "m. <i>a smacking</i> or <i>cracking sound;</i> hundrað rasta heyrði smell, Skíða R. 150.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/smelt"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          smelt

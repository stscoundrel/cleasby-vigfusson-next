          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          gróðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m., gen. gróðrar, [Dan. <i>afgröde;</i> Swed. <i>gröda</i> = <i>crop</i>], <i>growth, a crop;</i> þá fundu þeir Góibeytla ok annan gróðr (<i>vegetation</i>), Landn. 226; hverr maðr á gróðr á sínu landi, Grág. ii. 291, cp. Jb. 248 C. (Ed. vöxt); en at miðjum vetri blóta til gróðrar, Hkr. i. 13; gróðrum ok grænum grösum, Stj. 276: metaph., andlegs gróðrar, Hom. 45: <i>summer,</i> Edda (Gl.)",
            }
          }
        />
      </li>

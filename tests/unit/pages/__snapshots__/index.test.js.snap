        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a share of honour,</i> Lv. 55, Sturl. i. 105; þessi tvau hundruð silfrs skaltú þiggja, ok er þetta nökkurr sæmdafhlutr, <i>some acknowledgment,</i> Band. 26 new Ed.",
            }

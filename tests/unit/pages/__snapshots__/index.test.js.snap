            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dagverdar-drykkja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dagverðar-drykkja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. = dagdrykkja, <i>the drinking after</i> dagverðr, Fas. iii. 530, Mag. 3.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dal-bui"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dal-búi
        </a>
        <p
          dangerouslySetInnerHTML={

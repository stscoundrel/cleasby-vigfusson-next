        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, [Germ. <i>offenbaren</i>], <i>to manifest, reveal,</i> Bs. i. 275, 869, passim, H. E. i. 526.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/opin-beran"

          onTouchStart={[Function]}
        >
          skuldar-kona
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a woman in bondage for debt</i> (skuld l. 2); ef s. leggsk með þræli, þá á ármaðr ekki á henni fyrr en hón hefir goldit hina skuld, N. G. L. i. 36.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skuldar-madr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rauf"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rauf
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [A. S. <i>reâf;</i> O. H. G. <i>rauf,</i>] <i>spoils;</i> see valrauf.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rauf-2"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rauf
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f., pl. raufar, [raufa I, rjúfa], <i>a rift, hole;</i> þat er heilund, er rauf er á hausi til heila, Grág. ii. 11; rauf var á belgnum, Ld. 156; þeir lustu á rauf á hellunni, Edda 40; Flosi hugði at handklæðinu ok var þat raufar einar, Nj. 176; rauf á selgeiranum, Fms. vii. 202; þeir brutu þar á raufar, Eg. 125; bora sex raufar á, N. G. L. i. 172, Ó. H. 108; raufar himins, <i>the sluices of heaven,</i> 655 ix. B, (himin-raufar, Gen. vii. 11); bak-rauf, got-rauf, q. v.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rauf-lauss"
          onClick={[Function]}

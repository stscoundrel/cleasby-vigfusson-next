          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          blikra
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, [Ivar Aasen blikra, <i>to flutter</i>], <i>to blink;</i> impers. with dat., kvaðst hann eigi hirða þó bónda blikraði nokkut til hvat fyrir væri (= blöskraði, <i>felt a shudder</i>), Grett. 100 A (rare).",
            }
          }
        />
      </li>

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a releaser,</i> 656 B: eccl. <i>the Redeemer,</i> Stj. 27, Horn, 36, Barl. 30, Pass., Vidal. passim.",
            }

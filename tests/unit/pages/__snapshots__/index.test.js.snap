        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a drinking party,</i> Hkr. i. 50, Sturl. iii. 126, Eg. 258.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

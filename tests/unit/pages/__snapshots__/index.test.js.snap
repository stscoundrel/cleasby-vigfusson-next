        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nordr-sveitir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          norðr-sveitir
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. pl. <i>the northern counties,</i> Fms. ii. 202.",
            }

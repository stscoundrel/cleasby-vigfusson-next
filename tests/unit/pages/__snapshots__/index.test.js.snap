          onTouchStart={[Function]}
        >
          tún-svið
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>the</i> tún-<i>space</i>; sem túnsvið kringlótt, <i>a field like a round</i> tún-<i>enclosure,</i> Fms. vii. 97 (v. l. nær túns-vídd, of the largeness of a tún).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tun-svin"

      </li>
      <li>
        <a
          className="link"
          href="/word/thembinn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þembinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>inflated, blown up.</i> <strong>þembi-þrjótr,</strong> m. <i>a puffed-up rogue, charlatan,</i> Orkn. (in a verse).",
            }
          }
        />
      </li>

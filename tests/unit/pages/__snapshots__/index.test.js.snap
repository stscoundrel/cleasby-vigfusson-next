        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>keen-eyed,</i> like an eagle, Stj. 225, Fms. xi. 205, Nj. 30, Ó. H. 16; snareygja (acc.), 656 B. 11.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snar-fari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snar-fari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>the swift, smart man,</i> a nickname, Landn.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snar-kringla"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snar-kringla
        </a>
        <p
          dangerouslySetInnerHTML={
            {

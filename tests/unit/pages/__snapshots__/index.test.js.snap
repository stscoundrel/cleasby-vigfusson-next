          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rengð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a challenge;</i> lög rengd, Grág. i. 31.",
            }

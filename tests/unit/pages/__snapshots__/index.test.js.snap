        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a loose, unreal, shifty agreement,</i> Bs. i. 519.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tylli-sok"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tylli-sök
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a light, futile charge,</i> Glúm. 377.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/typpa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          typpa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "t, [toppr], <i>to tip, top;</i> ok hagliga um höfuð typpum, <i>to tip his head,</i> with a woman’s hood, Þkv. 16: <strong>typptr,</strong> adj. <i>tipped, laced,</i> Js. 78; silfr-typptr, <i>silver-tipped,</i> of the waves, Snót 36.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/typpi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          typpi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a tip</i> (Lat. <i>apex</i>), Fms. vi. (in a verse), and in mod. usage.",
            }

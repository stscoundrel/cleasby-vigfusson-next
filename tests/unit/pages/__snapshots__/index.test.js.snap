          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sendi-ferð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>sendi-för,</strong> f. <i>a message, errand,</i> Nj. 74; fara s., Eg. 119, 540, Ó. H. 52; í sendiförum, Fms. i. 15; þeir höfðu sendiferðir konungs allar, Eg. 73; koma í s. e-s, Hkr. i. 192.",
            }

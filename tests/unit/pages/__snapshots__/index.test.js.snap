          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a friend who knows one’s secrets;</i> kona er rúna bónda síns, Edda ii. 602; Kolbeins rúna, <i>K.’s wife,</i> Gd. 18; eyra-rúna, q. v.",
            }
          }
        />
      </li>

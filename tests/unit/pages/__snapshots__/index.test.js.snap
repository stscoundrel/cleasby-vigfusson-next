          className="link"
          href="/word/tjald-steinn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tjald-steinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a tent-stone, a rock looking like a tent,</i> Dropl. 33.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tjald-stokkr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tjald-stokkr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a tent-block,</i> Fas. ii. 285.",
            }

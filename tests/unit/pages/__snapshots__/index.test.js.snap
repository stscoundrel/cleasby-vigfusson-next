        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ludra"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lúðra
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to stoop, cringe,</i> perhaps a metaphor taken from the stooping over a bin; lúðrandi lágt, Stj. 398; fara lúðrandi fyrir kné ábóta, Mar.; lúðra lágt, Thom. 535.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ludra-gangr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lúðra-gangr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>the sound of trumpets,</i> Hkr. ii. 221, Fms. vii. 289.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ludra-thytr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lúðra-þytr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "and <strong>lúðr-þytr,</strong> m. id., Fms. viii. 226, 1 Cor. xv. 52.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ludrs-hljod"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          lúðrs-hljóð

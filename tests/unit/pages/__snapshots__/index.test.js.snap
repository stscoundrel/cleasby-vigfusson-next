          className="link"
          href="/word/snar-bryna"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snar-brýna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ð, <i>to whet keenly,</i> Fas. i. 232.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snar-eygr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

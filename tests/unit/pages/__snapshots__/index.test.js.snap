          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          snifinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. of a lost strong verb, = Gr. νιφόμενος, <i>snowed-on;</i> var ek snifin snjóvi, ok slegin regni, ok drifin döggu, Vkv. 5.",
            }
          }
        />
      </li>
      <li>

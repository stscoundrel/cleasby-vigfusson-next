        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "Grett. 90, read Vínlendingr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vindli"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vindli
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. = vindill; stundum fauk hann sem vindli, Mork. 41.",
            }
          }

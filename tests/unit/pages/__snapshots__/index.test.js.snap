        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f., pl. sleifar, [Dan. <i>slæv</i>], <i>a ladle,</i> esp. a wooden ladle to stir with.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sleiking"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

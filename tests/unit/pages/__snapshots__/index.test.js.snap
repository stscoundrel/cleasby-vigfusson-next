        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sael-keri"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sæl-kéri
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. = sælingr, Edda i. 532: in mod. usage <i>an epicurean,</i> hann er mesti s.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sael-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sæl-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>blissfully;</i> svá s. sett í Paradiso, Niðrst. 4; s. frammlíðandi, Fms. iii. 172.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sael-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sæl-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>happy, wealthy, blissful;</i> svá sælligt setr, Ls. 43; hann sagði sælligra (<i>more blessed</i>) vera at gefa enn þiggja, 655 xvi. B. 2; þetta er ok sælligra, Hom. 28.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sael-lifi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sæl-lífi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a life of enjoyment;</i> krásir eðr s., Stj. 68; vanr áðr sæmd ok s., Fms. iii. 95; á engis konungs æfi var þar alþýðu slíkt s. sem um hans daga, vi. 441; sællífis paradís, Stj. 39: = Lat. <i>luxuria,</i> Róm. 303.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sael-lifr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sæl-lífr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>living a life of enjoyment,</i> Edda 13; s. at fæðslu, Greg. 22 (of Dives); svá s. sem Salomon, Eluc.; hirt þú líkam þinn ok georsk eigi s., Hom. (St.)",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/saela"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

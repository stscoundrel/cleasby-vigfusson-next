          onTouchStart={[Function]}
        >
          vesla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a well that never freezes;</i> see vermsl.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vesladr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          veslaðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>wretched,</i> Nj. 124, v. l.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/veslask"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          veslask
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to grow wretched, poor;</i> segja at staðr þeirra mun ekki veslask við, þótt …, Þiðr. 41; veslast upp, <i>to pine away.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/veslingr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          veslingr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. (<strong>veslingi,</strong> a, m., Art. 43). [Dan. <i>usling,</i> used in a bad sense]:—<i>a poor, puny person;</i> hvat myndi veslingr þessi (<i>this wretch</i>) varða mér bátinn, Fms. vii. 32; sveinar tveir, veslingar, Fær. 42; Guðs veslingr, Mar.; mostly in a compassionate or charitable sense, like Engl. <i>poor.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/veslugr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          veslugr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>poor, wretched,</i> Nj. 194, v. l.; aum kona ok veslug, Stj. 428; fátækan ok veslugan, 212, Fas. iii. 525.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

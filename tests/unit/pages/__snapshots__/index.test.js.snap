          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klof-vega
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "in the phrase, ríða k., <i>to ride astride;</i> opp. to ein-vega, like women on a side-saddle, (mod.)",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klofa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          klofa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, <i>to stand</i> or <i>stride with the legs apart;</i> klofa snjó.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/klofa-kerling"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

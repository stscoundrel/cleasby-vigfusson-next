        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sleipr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sleipr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. [North. E. <i>slape</i>], <i>slippery,</i> Vígl. 31; háfa steinstrætið heimsins sleipt, hefir mér opt í vanda steypt, Pass. 34. 14, freq. in mod. usage.",
            }
          }
        />

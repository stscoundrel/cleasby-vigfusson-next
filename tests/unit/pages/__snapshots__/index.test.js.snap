        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hamingju-mot"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hamingju-mót
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>lucky appearance;</i> h. er á pér, Fs. 11.",
            }

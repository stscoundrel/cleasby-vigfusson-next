          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          út-lægr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>outlawed, banished,</i> Js. 20, K. Á. 190, 194; fara ú., Fms. vii. 240; ú. af Svíþjóð, x. 32; ú. í Noregi, Eg. 160; útlægan, Fms. vi. 33; útlægjan, 35; göra útlæga, vii. 252; björn ok úlfr skal hvervetna útlægr vera, N. G. L. i. 45.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

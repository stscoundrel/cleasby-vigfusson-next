        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [njóta], <i>the use</i> of a thing; ok á sá at sækja um nautnina er hross á, Grág. i. 432; nautn á skógi, ii. 293; ef maðr neytir hross enni meiri nautn, en þat er meiri nautn …, i. 441.",
            }
          }

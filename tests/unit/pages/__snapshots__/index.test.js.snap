          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          inn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> adv., compar. <strong>innar,</strong> superl. <strong>innst,</strong> [Ulf. <i>inna;</i> A. S. <i>in;</i> Engl. <i>in;</i> Germ. <i>ein;</i> Dan. <i>ind;</i> Swed. <i>in;</i> Lat. <i>intus</i>]:—<i>into, in,</i> denoting motion towards the place; ganga inn í búðina, Nj. 3; ganga inn, <i>to go in-doors,</i> Rm. 2; í búð inn, Grág. i. 31; út ok inn, Nj. 104, Vkv. 4; setja inn, <i>to shut in,</i> Grág. i. 418, 436; hafa e-n inn, <i>to take a person in, give him lodging,</i> Grág. i. 229 new Ed.; kasta inn, <i>to cast into prison,</i> Fms. x. 155; leggja inn skipi, <i>to berth a ship,</i> xi. 323.",
            }
          }
        />
      </li>

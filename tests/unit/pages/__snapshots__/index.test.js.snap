        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a great artist, master-craftsman;</i> hann er þjóðhag., or as adj., hann er þjóðhaga smiðr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thjod-hagr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/var-farinn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          var-farinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {

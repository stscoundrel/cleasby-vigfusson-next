          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vægi-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>forbearingly, leniently,</i> Lv. 10, Fms. vii. 18, Earl. 73, Stj. 594, Sks. 42.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vaegi-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

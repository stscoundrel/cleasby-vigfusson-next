        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a killing snow storm,</i> Eb. 150.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drep-rad"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drep-ráð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. a law term (cp. áljóts-ráð, sár-rúð, bana-ráð, fjör-ráð), <i>an intended affray</i> or <i>assault,</i> Grág. ii. 116, 117, Vsl. ch. 75.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drep-samligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drep-samligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>deadly, destructive,</i> Stj. 71.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drep-sleggja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drep-sleggja
        </a>
        <p
          dangerouslySetInnerHTML={
            {

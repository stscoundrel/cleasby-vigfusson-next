        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>quickness, sprightliness,</i> MS. 4. 5.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/snar-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

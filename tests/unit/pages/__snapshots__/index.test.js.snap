        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a man from the west,</i> Sturl. ii. 204, iii. 86, Ísl. ii. 170, Gullþ. 45.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vestan-vedr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

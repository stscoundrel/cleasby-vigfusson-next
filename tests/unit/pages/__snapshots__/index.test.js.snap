        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>wretched,</i> of a person, Háv. 53; vesalmannligt verk, Grett. 91 A.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vesal-menni"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

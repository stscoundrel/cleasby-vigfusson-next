        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>brave, bravely,</i> Korm. 238, Nj. 180, 258, Ld. 206.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/drengi-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          drengi-ligr

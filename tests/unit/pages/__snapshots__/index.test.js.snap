        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>the ring of the voice;</i> eg þekki hann á málrómnum.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/mal-rum"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

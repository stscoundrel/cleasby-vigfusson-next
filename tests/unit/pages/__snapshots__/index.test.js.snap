          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sár-heitr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>‘sorely-hot,’ very hot,</i> Grett. 126 A; [cp. Germ. <i>sehr</i>; Dan. <i>saare;</i> Engl. <i>sore</i>.]",
            }

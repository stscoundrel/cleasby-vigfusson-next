          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          bjarg-rýgr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "jar, f. pl. ir, a Norse law term, <i>a female witness in a case of paternity,</i> defined, N. G. L. i. 358.",
            }
          }
        />
      </li>
      <li>

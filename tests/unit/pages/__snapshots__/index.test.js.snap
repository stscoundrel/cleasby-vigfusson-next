        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ð, <i>to sit cowering,</i> Ls.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/hnukr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hnúkr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

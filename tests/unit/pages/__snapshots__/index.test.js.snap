        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>disturbance, vacancy of mind.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vingla"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vingla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, [vingull], <i>to confound, disturb;</i> vinglaðr, <i>confused, out of one’s mind.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vingnir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

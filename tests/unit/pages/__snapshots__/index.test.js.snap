        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>merda,</i> N. G. L. i. 29, passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skitugr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

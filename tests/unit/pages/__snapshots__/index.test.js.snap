      <li>
        <a
          className="link"
          href="/word/vindr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vindr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> m. <i>a winding;</i> austan við bergit er vindr upp út ganga, Symb. 56; hann hyggr at um steina nokkura þá er svá lágu sem vindr er görr, Róm. 309.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vindr-2"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vindr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [Ulf. <i>winds</i> = ἄνεμος; A. S., Engl., and Germ. <i>wind;</i> O. H. G. <i>wint;</i> Lat. <i>ventus</i>]:—<i>the wind,</i> passim: <i>the air,</i> fram í loptið í vindinn, <i>into the air,</i> Fms. vi. 313; sem hann væði vind, 419; kasta e-u út í vind, Mar.; verpa orðum í vind, id.; láta e-t sem vind um eyrun þjóta (see eyra): allit., veðr ok vind, kvíða fyrir vind ok vatn, Fms. viii. 234; í vindi skal við höggva, Hm.; þokur miklar en vinda litla, Ld. 74; vindr hafði hlaupit milli, Bs. i. 336; blés mikinn vind á ljósit en þat sloknaði, Bárð. 180; gékk vindr ór filnum, Al. 144; austan-v., vestan-v., sunnan-v., norðan-v. (but út-synningr, land-nyrðingr, etc., of the ‘middle-airts’).",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vinds-fullr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vinds-fullr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj., Fas. ii. 150.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vinds-gnyr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vinds-gnýr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a squall of wind,</i> Ld. 326.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vindugr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vindugr
        </a>

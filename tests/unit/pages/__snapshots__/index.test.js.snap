          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mál-lauss
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>speechless,</i> of a sick person: <i>dumb,</i> daufr ok m., Ld. 34, Stj. 261, Fb. i. 251, ii. 382, MS. 625, 85.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

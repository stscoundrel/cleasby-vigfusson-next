      <li>
        <a
          className="link"
          href="/word/tjald-staedingr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tjald-stæðingr
        </a>
        <p
          dangerouslySetInnerHTML={

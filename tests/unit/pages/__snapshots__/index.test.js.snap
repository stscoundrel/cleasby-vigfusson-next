        >
          skil-ríkr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. - skilrekkr; s. maðr, Nj. 235, Fms. xi. 101, K. Á. 208, Gþl. 58, Grett. 90 A; s. bóndi, 110.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skil-samr"
          onClick={[Function]}
          onMouseEnter={[Function]}

              "__html": "adj. (<strong>-liga,</strong> adv.), <i>clerical,</i> 625. 85, Sks. 490: <i>with the air, dignity of a priest,</i> Bs. i. 183.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kennimann-skapr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

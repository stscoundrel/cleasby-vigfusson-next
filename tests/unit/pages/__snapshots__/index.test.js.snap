      <li>
        <a
          className="link"
          href="/word/bryna"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          brýna
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> d, [brún], <i>to whet,</i> <i>sharpen,</i> ‘<i>bring to an edge</i>’; b. ljá, kníf, sverð, <i>to whet a scythe,</i> <i>knife,</i> <i>sword,</i> Edda 48, Ísl. ii. 348, Fs. 62.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/bryni"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          brýni
        </a>

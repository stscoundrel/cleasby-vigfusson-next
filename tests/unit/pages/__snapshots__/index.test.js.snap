        <a
          className="link"
          href="/word/olm-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ólm-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>furiously, savagely,</i> Nj. 104, Karl. 520.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/olm-ligr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ólm-ligr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>furious, savage,</i> Fas. iii. 411, Ld. 234.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/olmast"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ólmast

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adv. <i>in the west of a fiord,</i> Landn. 352.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vest-firzka"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vest-firzka
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>a custom in the west</i> (of Icel.), Sturl. ii. 167: <i>an idiom, language of Western Iceland.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vest-firzkr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aedi-kolla"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          æði-kolla
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>an eider-duck,</i> very freq. in mod. usage instead of the single æðr, q. v.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/aedi-kollr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          æði-kollr

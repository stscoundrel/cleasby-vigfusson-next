        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [hverfa at, <i>to turn towards</i>]:",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/at-hygli"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          at-hygli
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. [athugall], <i>beedfulness, attention;</i> með a., Sks. 1, 445 B, 564, Fms. vi. 446, (now used as neut.)",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

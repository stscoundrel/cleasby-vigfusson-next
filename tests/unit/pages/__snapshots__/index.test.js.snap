          className="link"
          href="/word/fram-girni"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fram-girni
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>forwardness,</i> Fms. v. 246, Fbr. 121.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/fram-gjarn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fram-gjarn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>striving forward,</i> H. E. i. 250, Thom. 28.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/fram-hald"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fram-hald
        </a>
        <p

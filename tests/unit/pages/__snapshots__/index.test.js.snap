        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>sjón-daufr,</strong> adj. <i>dim-eyed:</i> <strong>sjón-depra,</strong> u, f. <i>dim-sightedness.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

          onTouchStart={[Function]}
        >
          mál-laki
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a defect,</i> of the speech organs; var mikill m. á ráði hennar, hón hafði ekki mál, ok var með því alin, Fb. i. 250.",
            }
          }
        />
      </li>
      <li>

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>black in the mouth;</i> komi þá engi kolmúlugr úr kafi, þá er ördeyða á öllu norðr-hafi, of fishes, Ísl. Þjóðs. ii. 130 (in a ditty).",
            }
          }
        />
      </li>

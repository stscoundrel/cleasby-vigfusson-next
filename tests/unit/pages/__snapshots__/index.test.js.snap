      <li>
        <a
          className="link"
          href="/word/ryk"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ryk
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. [rjúka], <i>dust, powder;</i> einsog ryk, Stef. Ól., passim in mod.usage. <strong>ryk-mökkr,</strong> m. <i>a dust-cloud.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rykill"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rykill
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. a nickname, Fms. i. 5.",
            }

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a fresh fish, cod,</i> Bs. i. 853.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/blaut-holdr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          blaut-holdr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

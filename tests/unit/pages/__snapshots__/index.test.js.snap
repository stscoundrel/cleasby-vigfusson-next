            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/skja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skjá
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "ð, <i>to stretch the membrane</i> skjall <i>over a window-frame;</i> glyggi smá ok alla skjáða, Sks. 427; konu-tetrið öngan gluggan skjáði, Hallgr.",
            }
          }
        />

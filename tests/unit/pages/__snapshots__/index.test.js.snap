        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m., gen. ja, pl. jar, <i>a leader, captain,</i> Fær. 106, Hom. 111, Fs. 57, Vápn. 25, Bs. i. 48, Fms. iv. 147, v. 295; hers-f., liðs-f., <i>a captain of troops;</i> skips-f., <i>a ship’s captain.</i>",
            }
          }
        />
      </li>

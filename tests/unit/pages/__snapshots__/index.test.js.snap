          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          spraki
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a rumour, flying report,</i> Fms. i. 187, viii. 365, 416.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          æða
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "i. e. <strong>œða,</strong> d, [óðr], <i>to rage;</i> þá frá ek él it ílla æða, Jd. 31: mostly,",
            }

      <li>
        <a
          className="link"
          href="/word/laeknis-gras"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          læknis-gras
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a healing herb,</i> Pr. 470.",
            }
          }
        />

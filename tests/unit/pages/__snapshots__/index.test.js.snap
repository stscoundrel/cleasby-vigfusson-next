            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/trolli"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          trolli
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. a nickname, Landn. (cp. Dan. <i>Herluf Trolle</i>); whence in local names, <strong>Trolla-tunga,</strong> Landn.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/trolls-hamr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          trolls-hamr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a troll’s shape,</i> Vsp.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/trolls-hattr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          trolls-háttr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. a kind of <i>metre,</i> Edda (Ht.)",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/trolls-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

              "__html": "m. <i>wood for rafters,</i> Vm. 108.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rapt-vidr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rapt-viðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>wood for rafters,</i> Am. 30; raptviðar-högg, D.I. i. 522.",
            }
          }
        />
      </li>

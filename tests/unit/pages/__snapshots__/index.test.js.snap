            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dreyr-gjarn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dreyr-gjarn
        </a>
        <p
          dangerouslySetInnerHTML={
            {

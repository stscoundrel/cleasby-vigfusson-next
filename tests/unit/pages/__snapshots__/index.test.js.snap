              "__html": "or <strong>kald-rani,</strong> a, m. <i>a taunt, sarcasm.</i> <strong>kaldrana-legr,</strong> adj. <i>sarcastic.</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

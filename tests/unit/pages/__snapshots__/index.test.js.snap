          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sækjandi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>a prosecutor,</i> opp. to verjandi, Grág., Nj. passim.",
            }
          }
        />
      </li>
      <li>

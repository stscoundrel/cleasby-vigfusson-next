          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          uppreistar-saga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. <i>the story of Creation, Genesis,</i> Fms. v. 65, Vm. 6; svá sem segir í uppreistar sögu at Guð górði alla hluti í senn, Bs. i. 575, Hom. (St.)",
            }
          }
        />
      </li>
      <li>

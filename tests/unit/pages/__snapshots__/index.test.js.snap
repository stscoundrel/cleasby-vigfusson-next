      <li>
        <a
          className="link"
          href="/word/dan"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dan
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. [dominus], <i>sir.</i> D. N.; hence comes perhaps the mod. Icel. word of-dan, það er mér ofdan, <i>‘tis too great a honour for me;</i> else the word is quite out of use.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/danga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          danga
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "að, [dengja], <i>to bang, thrash,</i> Skíða R. 136.",
            }

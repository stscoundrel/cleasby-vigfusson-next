          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nagl-far
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>the mythical ship</i> made of nail-parings, Vsp. 50; for the tale see Edda 41.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

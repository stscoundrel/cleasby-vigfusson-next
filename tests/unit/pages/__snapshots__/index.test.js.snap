          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          væ
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "interj. = vei; vesöl eru vér, ok væ er oss fyrir, Fagrsk. ch. 193.",
            }

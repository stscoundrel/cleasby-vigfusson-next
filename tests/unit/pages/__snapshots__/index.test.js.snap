          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tyrkir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tyrkir
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "gen. pl. Tyrkja, m. pl. <i>the Turks,</i> Bret., Edda (pref.), Landn. 19: <strong>Tyrk-land,</strong> <i>the land of the Turks,</i> Bret.: <strong>Tyrk-neskr,</strong> adj. <i>Turkish,</i> Mar., Karl.",
            }
          }
        />
      </li>

          className="link"
          href="/word/skermsl"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          skermsl
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. pl. [akin to sker], <i>rugged, broken, rocky ground;</i> halda þangat fénu at þeir fái versta haga ok skermsl eru mest, Ísl. ii. 181.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

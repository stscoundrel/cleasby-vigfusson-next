            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ta"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          tá
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> f., gen. tár, pl. tær, gen. tá, dat. tám; [A. S. <i>tâ;</i> Engl. <i>toe;</i> Germ. <i>zehe;</i> Swed. <i>tå;</i> cp. Lat. <i>digitus;</i> Gr. δάκτυλος]:—<i>a toe</i>; táin in mesta var miklu meiri á Ólafi enn á öðrum mönnum, Sd. 167; tána mestu, Nj. 245, Ó. H. 75; fimm tær, id.; tám eða hæl, Edda 42; horfa hælar í tá (gen. pl.) stað, en tær í hæls stað, N. G. L. i. 339, Bs. i. 423; standa á tá, <i>to stand a-tiptoe:</i> phrases, græða á tá og fingri, <i>to make money with toe and finger,</i> of one who grows quickly rich.",
            }
          }
        />
      </li>

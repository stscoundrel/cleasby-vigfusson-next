            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kanoki"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kanoki
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "and <strong>kanuki,</strong> a, m. [mid. Lat. <i>canonicus;</i> Dan. <i>kanik;</i> Engl. <i>canon</i>]:—<i>a canon</i> of a church, Fms. viii. 376, ix. 532, Bs., H. E., D. I. passim; kanoka klaustr, setr, lifnaðr, vígsla, búningr, <i>a canon’s cloister, seat, order, ordination, dress,</i> Ann. 1295, Bs. passim.",
            }
          }
        />
      </li>
      <li>

          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>worse for drink,</i> Fms. xi. 424, passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/olvir"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

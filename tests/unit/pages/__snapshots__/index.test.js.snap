        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>from the county</i> Hvin in Norway, Fms. <strong>Hvin-verjar,</strong> m. pl. <i>the men from</i> Hvin: <strong>Hvinverja-dalr,</strong> a local name, Landn.",
            }
          }

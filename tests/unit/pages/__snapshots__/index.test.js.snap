          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hollusta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>hollosta</strong>), u, f. <i>faith, loyalty;</i> vil ek hafa þar til hollostu þína í mót, Fms.: esp. <i>loyalty</i> to a liege lord, h. við konung, Fb. ii. 265, passim.",
            }
          }
        />

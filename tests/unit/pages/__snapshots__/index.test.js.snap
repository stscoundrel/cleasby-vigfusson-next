        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thung-baerr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þung-bærr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>heavy to bear,</i> Eg. 379, Ld. 130: mostly metaph. <i>burdensome.</i> Eg. 226, Hkr. ii. 63, and so in mod. usage.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"

        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>the King of Glory</i> (Christ), Niðrst. 4.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dyrdar-korona"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dýrðar-kóróna
        </a>
        <p
          dangerouslySetInnerHTML={
            {

          onTouchStart={[Function]}
        >
          mildr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "mild, milt, adj. [Goth. <i>milds,</i> in <i>un-milds</i> = ἄστοργος; A. S., Engl., etc. <i>mild</i>]:—<i>mild, gentle, graceful;</i> mildastr ok ágæztr, Íb. 14; glaðr ok kátr, m. ok lítillátr, Fms. x. 88: <i>gentle,</i> m. ok meinlauss, 281. Stj. 241, Bret. 102 (= Lat. <i>pius,</i> of Aeneas); ú-mildr, komast í ó-mildar hendr, <i>to come into bad hands</i>:—of weather, <i>mild</i>.",
            }
          }

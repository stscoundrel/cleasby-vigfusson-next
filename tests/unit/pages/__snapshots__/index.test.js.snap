        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> ð, [slóg], <i>to clean out fish;</i> s. þorsk, silung, lax.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/slaegju-land"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          slægju-land

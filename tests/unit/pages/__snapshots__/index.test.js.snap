      </li>
      <li>
        <a
          className="link"
          href="/word/thelli-safl"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þelli-safl
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>the sap of young pine-trees,</i> Fms. viii. 33.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/thelli-vidr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

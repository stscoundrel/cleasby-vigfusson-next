        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>wet weather,</i> Bs. i, Fbr. 147, Fas. ii. 378. <strong>vátviðra-samr,</strong> adj., Sturl. ii. 89 C.",
            }

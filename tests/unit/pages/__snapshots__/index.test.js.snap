        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m., gen. kundar, poët. <i>a son, kinsman,</i> Lex. Poët. passim.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kunn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kunn
        </a>
        <p
          dangerouslySetInnerHTML={

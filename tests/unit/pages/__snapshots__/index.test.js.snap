        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>having a large root,</i> Ísl. ii. 14.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/rot-setja"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          rót-setja
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "setti, <i>to root, plant,</i> H. E. i. 499, Stj. 644.",
            }

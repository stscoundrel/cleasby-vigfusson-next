          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          ljóð-framaðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a princely person,</i> Ad. 4.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/ljod-fyllandi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

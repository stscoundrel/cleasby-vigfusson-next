        />
      </li>
      <li>
        <a
          className="link"
          href="/word/leka"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          leka
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "pres. lek; pret. lak, láku; part. lekit; a weak part. lekat occurs, Fms. ix. 345; [A. S. <i>leccan;</i> Engl. <i>leak</i>; Dan, <i>lække</i>]:—prop. <i>to drip, dribble;</i> af þeim legi er lekit hafði ór hausi Heiðdraupnis, Sdm. 13:—<i>to leak,</i> of a ship or vessel, en hón lak eigi heldr enn it þéttasta kerald, Bs. i. 596; var mjök lekat skipit, Fms. ix. 345; leka eins og hrip, freq. in mod. usage: of milch kine, en á öðru kvikfé ef þat lekr, Jb. 366.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/leki"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          leki
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. <i>a leakage, leak;</i> kómu þá lekar at skipinu, Grett. 96: the phrase, sjá við þeim leka, <i>to see to a future leak (emergency).</i>",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/lekr"

          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          fram-gengt
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. n. (fem., Fms. x. 401), <i>brought about, successful;</i> in the phrase, verða f., <i>to succeed, come to pass.</i> Ld. 238, Fms. i. 277, vii. 5, 183, Sks. 32, 560, Ýt. 1.",
            }
          }
        />
      </li>

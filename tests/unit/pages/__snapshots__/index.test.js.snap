            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sanninda-sogn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sanninda-sögn
        </a>
        <p
          dangerouslySetInnerHTML={

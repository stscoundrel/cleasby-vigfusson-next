        />
      </li>
      <li>
        <a
          className="link"
          href="/word/kumrskr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          kumrskr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "or <strong>Kumbskr,</strong> adj. <i>from Cumberland,</i> Hallfred.",
            }

        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>adjective,</i> Skálda.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-leggr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-leggr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>wooden-leg,</i> a nickname, Eb.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-leitinn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-leitinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>trying one’s best;</i> vera v. um e-t, Fms. iii. 113.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-leitni"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-leitni
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>a trying to do one’s best, an attempt,</i> Fms. ii. 271.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vid-lika"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          við-líka
        </a>
        <p
          dangerouslySetInnerHTML={

          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> u, f. <i>loss of luck;</i> h. er mér, <i>luck has left me,</i> Fs. 98; kvaðsk þeim h. at þykkja, Fms. vii. 272.",
            }
          }
        />
      </li>

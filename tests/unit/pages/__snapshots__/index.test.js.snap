        <p
          dangerouslySetInnerHTML={
            {
              "__html": "(<strong>-leiki</strong>), m. <i>soreness, pain</i>, Hom. 29, Ver. 72, Stj. 21, 38, 97, 189, Bs. ii. 25: metaph. <i>pain</i>, Hom, 11, Bs. i. 142.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/sar-liga"

          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          væng-brotinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>broken-winged,</i> Grett. 91 A.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vaeng-knui"

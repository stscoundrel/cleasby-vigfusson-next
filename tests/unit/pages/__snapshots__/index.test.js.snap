      <li>
        <a
          className="link"
          href="/word/vestan-verdr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vestan-verðr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>westwards, western,</i> Stj. 75, Eg. 135, Þorst. Síðu H. 7.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vestan-vindr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vestan-vindr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a west wind,</i> Sks. 39, Stj. 69.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vestari"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          vestari
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "compar., as also <strong>vestri,</strong> <i>more westerly;</i> superl. <strong>vestastr,</strong> <i>most westerly;</i> vestri úbygð, Landn. 105; til vestri bygðar, 107; ena vestri leið, Nj. 281; um vestra stræti, Fms. ix. 22; eptir Rangá enni vestarri, ii. 208; inn vestasti farvegr, Pm. 42; liggja þessi lönd vestust, Fms. ix. 412; fór hann til vestasta Ásólfs-skála, Landn. 53.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/vestarliga"

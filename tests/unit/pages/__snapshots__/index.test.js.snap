      </li>
      <li>
        <a
          className="link"
          href="/word/sval-kaldr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          sval-kaldr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>cooling, cold,</i> of the sea, Hdl.",
            }

      </li>
      <li>
        <a
          className="link"
          href="/word/myrk-faelni"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          myrk-fælni
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>the being afraid in the dark,</i> Grett. 130, Stj. 111.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/myrk-heimr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          myrk-heimr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>the world of darkness,</i> Akv. 42: in plur., í myrk-heimum, Edda 70.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/myrk-hraeddr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          myrk-hræddr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>afraid in the dark,</i> Fbr. 89, Gísl. 65.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/myrk-hraedinn"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          myrk-hræðinn
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. = myrkfælinn, Sturl. ii. 139.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/myrk-leikr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          myrk-leikr
        </a>
        <p
          dangerouslySetInnerHTML={
            {

          onTouchStart={[Function]}
        >
          roð
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a fish’s skin</i> (from the reddish colour), Eb. 276; roð af fiski, Clem. 25: freq. in mod. usage, þorsk-roð, háfs-roð, skötu-roð, steinbíts-roð, etc.",
            }

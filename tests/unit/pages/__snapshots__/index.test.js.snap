        <p
          dangerouslySetInnerHTML={
            {
              "__html": "<strong>1.</strong> a, m. <i>a snuffer,</i> Pm. 31; elda-skari, Magn. Ólafsson.",
            }
          }
        />
      </li>
      <li>

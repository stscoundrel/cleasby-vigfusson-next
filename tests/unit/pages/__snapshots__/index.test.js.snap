          className="link"
          href="/word/haeli"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          hæli
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a shelter, refuge;</i> leita sér hælis, eiga hæli, Fms. i. 210, vi. 74, xi. 367, Eg. 139, Barl. 118, Rd. 258. <strong>hælis-lauss,</strong> adj. <i>homeless, helpless.</i>",
            }
          }
        />

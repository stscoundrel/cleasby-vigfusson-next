        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. = landsván, Landn. 43 (v. l.), N. G. L. i. 346; ok er hann kom í landván við Noreg, Hkr. i. 292.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/land-vedr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}

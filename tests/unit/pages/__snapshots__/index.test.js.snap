        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u. f. <i>danger, peril,</i> Fms. iv. 122, 132; leggja á hættu, <i>to run a risk,</i> Eg. 86, 719; leggja sik, líf sitt í hættu, Fs. 4, 21, 41, Fms. iv. 86; eiga mikit í hættu, <i>to run a great risk,</i> Nj. 16, Fms. x. 232.",
            }
          }
        />
      </li>
      <li>

          className="link"
          href="/word/nabbi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nabbi
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "a, m. [Engl. <i>knob;</i> North. E. and Scot. <i>nab</i>], <i>a small protuberance</i> on the skin or on greensward; nabba-þýfi, fjalls-n., D. N. iii. 861, freq. in mod. usage: the name of a dwarf, Hdl. 7.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/nadda"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          nadda
        </a>
        <p
          dangerouslySetInnerHTML={
            {

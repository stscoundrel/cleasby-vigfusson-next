          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mál-stafr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>a letter of the alphabet;</i> rúnar heita málstafir. <i>Runes that are letters,</i> Skálda 163 (Thorodd): <i>a consonant,</i> opp. to hljóðstafr, <i>a vowel,</i> Skálda 170, 172 (the second grammarian).",
            }
          }
        />
      </li>

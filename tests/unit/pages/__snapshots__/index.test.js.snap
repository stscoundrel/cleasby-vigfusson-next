        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>a bereavement,</i> Bs. i. 146, v. l.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/yndi-liga"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          yndi-liga
        </a>
        <p
          dangerouslySetInnerHTML={
            {

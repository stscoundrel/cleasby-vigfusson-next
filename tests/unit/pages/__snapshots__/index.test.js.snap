        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>an otter-skin,</i> Edda 73, Fas. i. 153.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/otr-gjold"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

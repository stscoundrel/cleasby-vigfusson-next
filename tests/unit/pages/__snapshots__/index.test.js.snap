            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/mann-val"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          mann-val
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>choice people, a select body of men;</i> þat mesta m. á landinu, <i>the best men of the county,</i> Nj. 33, 173, Eg. 38, 43, Fms. vi. 46, x. 25: mod. also of one person, <i>a goodly man,</i> hann er mesta mannval.",
            }
          }
        />

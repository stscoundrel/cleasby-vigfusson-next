          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þarfa-gangr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. <i>‘need-going,’ urine, excrement,</i> Stj. 642, Fs. 180.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/tharfi"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >

            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dag-stund"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dag-stund
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. <i>day time, a whole day,</i> K. Þ. K. 6; dagstundar Leið, <i>a ‘Leet’</i> (i. e. <i>meeting</i>) <i>lasting a day,</i> Grág. i. 122:—elsewhere dagstund means <i>an hour</i> in the day time = stund dags.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/dag-staeddr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          dag-stæddr
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "adj. <i>fixed as to the day,</i> Thom. 56, Fms. xi. 445.",
            }

        />
      </li>
      <li>
        <a
          className="link"
          href="/word/karfa"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          karfa
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f., or <strong>körf,</strong> f., [Lat. <i>corbis</i>], <i>a basket;</i> akin to kerfi (q. v.), a <i>bunch,</i> a mod. word, the old being vand-laupr.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/karfasta"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          karfasta
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "u, f. = karina, Sturl.",
            }

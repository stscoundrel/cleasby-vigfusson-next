      <li>
        <a
          className="link"
          href="/word/thol"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          þol
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "n. <i>patience, endurance;</i> hann hafði við gott þol ok mikit, Fær. 346; hann bað Sturlu hafa þol við ok bíða, Sturl. ii. 131, Stj. 579, Fas. iii. 77; ó-þol, <i>impatience.</i>",
            }

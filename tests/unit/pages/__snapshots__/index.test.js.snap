        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "f. the name of an island.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/stripill"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
          stripill
        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "m. a <i>‘stripling;’</i> a smooth white-haired dog is in Icel. called stripill.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/striplast"

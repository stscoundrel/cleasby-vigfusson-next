        </a>
        <p
          dangerouslySetInnerHTML={
            {
              "__html": "part. <i>haired, hairy;</i> hærð kvenna bezt, Korm. 24, Landn. 151; vel h., Fms. vii. 199, Nj. 39.",
            }
          }
        />
      </li>
      <li>
        <a
          className="link"
          href="/word/haeringr"
          onClick={[Function]}
          onMouseEnter={[Function]}
          onTouchStart={[Function]}
        >
